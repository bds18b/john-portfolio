---
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif,webp,svg}');

const caseStudies = [
  {
    id: "feals",
    brand: "Feals",
    title: "Plugging Lifecycle Leaks",
    logoPath: "/src/assets/Feals-logo.svg",
    imagePath: "/src/assets/Feals-lifestyle-photo.jpg",
    description: "How do you drive big results for a major brand? We delivered a 222% surge in MRR YoY, spiked Email RPR by 323% while safely increasing total recipients by 40%, and scaled returning customer contribution margin by 222%.",
    metrics: [
      { value: "+222%", label: "MRR YoY" },
      { value: "+323%", label: "Email RPR" },
      { value: "+222%", label: "Contrib Margin" },
    ],
    isWide: true,
  },
  {
    id: "survival-frog",
    brand: "Survival Frog",
    title: "Zero Overhead Scaling",
    logoPath: "/src/assets/SurvivalFrog-logo.webp",
    imagePath: "/src/assets/survival-frog-lifestyle-image.webp",
    description: "Survival Frog's repeat revenue needed a performance overhaul. We systematically drove a 42% increase in Customer Lifetime Value (LTV) YoY, and successfully launched and scaled their SMS program to capture a 240% jump in attributed SMS revenue.",
    metrics: [
      { value: "+42%", label: "LTV YoY" },
      { value: "+240%", label: "SMS Rev YoY" },
    ],
    isWide: true,
    isFrog: true,
  },
];
---

<section id="case-studies" class="bg-[#efefed] py-10 overflow-hidden">
  <div class="max-w-[900px] mx-auto relative px-[clamp(16px,6vw,48px)] md:px-0">

    <!-- Pure CSS Layout Container -->
    <div 
      id="studies-main-container"
      class="flex flex-col overflow-visible gap-4 md:gap-6 w-full"
    >
      {caseStudies.map((study) => (
        <div 
          class:list={[
            "study-card group snap-center flex-shrink-0 w-full bg-white md:bg-[#e3e3e1]/50 border border-transparent rounded-[20px] overflow-hidden transition-all duration-500 flex flex-col md:h-[600px] md:col-span-2"
          ]}
          data-id={study.id}
        >
          <!-- Image Area -->
          <div class:list={[
            "image-trigger relative w-full overflow-hidden flex-shrink-0 transition-all duration-500 ease-in-out h-[280px] md:h-[600px] md:group-[.active]:h-[330px]"
          ]}>
            <Image 
              src={images[study.imagePath]()} 
              alt={study.brand}
              class="absolute inset-0 w-full h-full object-cover grayscale-[20%] md:group-hover:grayscale-0 transition-all duration-500 md:group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-black/40 md:bg-black/35 group-hover:bg-black/20 transition-colors duration-500"></div>
            
            <!-- Logo Overlay -->
            <div class="absolute inset-0 flex items-center justify-center p-8">
              <Image 
                src={images[study.logoPath]()} 
                alt={`${study.brand} logo`}
                class:list={[
                  "w-full h-auto object-contain brightness-0 invert opacity-90",
                  study.isFrog ? "max-w-[180px] md:max-w-[215px]" : "max-w-[120px] md:max-w-[145px]" 
                ]}
              />
            </div>
          </div>

          <!-- Content Drawer -->
          <div class:list={[
            "card-drawer bg-white overflow-hidden transition-all duration-500 ease-in-out flex-grow opacity-100 max-h-none md:max-h-0 md:opacity-0 md:group-[.active]:max-h-[270px] md:group-[.active]:opacity-100"
          ]}>
            <div class="p-6 md:p-8 border-t border-[#e0dedd] h-full flex flex-col justify-between">
              <div>
                <h3 class="font-oswald text-[1.25rem] md:text-[1.5rem] uppercase mb-2 text-[#1a1a18] tracking-wide">{study.brand}</h3>
                <p class="font-inconsolata text-[0.88rem] md:text-[0.92rem] leading-relaxed text-[#6b6b65]">
                  {study.description}
                </p>
              </div>
              
              <!-- FIX: Top border row now spans 100% width fully across the white card layout -->
              <div class="w-full border-t border-[#e0dedd] pt-4 mt-4 md:pt-6 md:mt-6">
                <!-- Inner grid system houses the metrics cleanly -->
                <div class:list={[
                  "grid gap-2",
                  study.metrics.length === 2 ? "grid-cols-2 max-w-[400px]" : "grid-cols-3"
                ]}>
                  {study.metrics.map(metric => (
                    <div>
                      <div class="font-oswald text-[1.4rem] md:text-[2.2rem] text-[#1a1a18] leading-none mb-1">{metric.value}</div>
                      <div class="font-inconsolata text-[0.6rem] md:text-[0.68rem] uppercase tracking-wider text-[#6b6b65] leading-tight">
                        {metric.label}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
              
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function setupCaseStudies() {
    const isMobile = window.matchMedia("(max-width: 768px)").matches;
    if (isMobile) return;

    const cards = document.querySelectorAll('.study-card');

    cards.forEach(card => {
      const trigger = card.querySelector('.image-trigger');
      trigger?.addEventListener('mouseenter', () => {
        cards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');
      });
      card.addEventListener('mouseleave', () => {
        card.classList.remove('active');
      });
    });
  }

  setupCaseStudies();
  document.addEventListener('astro:after-swap', setupCaseStudies);
</script>

<style>
  .font-inconsolata {
    font-family: "Inconsolata", "Courier New", monospace;
  }
  .font-oswald {
    font-family: "Oswald", sans-serif;
  }
</style>