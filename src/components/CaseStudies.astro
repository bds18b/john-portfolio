---
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif,webp,svg}');

const caseStudies = [
  {
    id: "feals",
    brand: "Feals",
    title: "Plugging Lifecycle Leaks",
    logoPath: "/src/assets/Feals-logo.svg",
    imagePath: "/src/assets/Feals-lifestyle-photo.jpg",
    description: "How do you drive big results for a $200M brand? You go deeper than anyone else to gain insights and maximize efficiency. We delivered significant revenue growth and increased loyalty.",
    metrics: [
      { value: "12%", label: "AVG LTV" },
      { value: "23%", label: "Repurchase" },
      { value: "10%", label: "Days Dec" },
    ],
    isWide: true,
  },
  {
    id: "highland",
    brand: "Highland",
    title: "Highland Peak Performance",
    logoPath: "/src/assets/Highland-logo.svg",
    imagePath: "/src/assets/Hyland-lifestyle-photo.jpg",
    description: "Highland needed a robust framework to handle their scaling acquisition costs. We systematically compounded LTV over a 6-month period without increasing overhead.",
    metrics: [
      { value: "18%", label: "Revenue" },
      { value: "34%", label: "Retention" },
      { value: "5.2x", label: "ROI" },
    ],
    isWide: false,
  },
  {
    id: "survival-frog",
    brand: "Survival Frog",
    title: "Zero Overhead Scaling",
    logoPath: "/src/assets/SurvivalFrog-logo.webp",
    imagePath: "/src/assets/survival-frog-lifestyle-image.webp",
    description: "Survival Frog's repeat revenue was flat. We rebuilt their flow matrix to capture the capital they were leaving behind without bloated agency retainers.",
    metrics: [
      { value: "15%", label: "AOV Inc" },
      { value: "28%", label: "Flow Rev" },
      { value: "14d", label: "Purchase" },
    ],
    isWide: false,
    isFrog: true,
  },
];
---

<section id="case-studies" class="bg-[#efefed] py-[clamp(60px,10vw,120px)] overflow-hidden">
  <div class="max-w-[900px] mx-auto relative px-[clamp(16px,6vw,48px)] md:px-0">
    
    <!-- Header -->
    <div class="mb-10 md:mb-12">
      <p class="font-inconsolata text-[0.75rem] font-bold tracking-[0.18em] uppercase text-accent mb-4">
        Proven Outcomes
      </p>
      <h2 class="font-oswald font-normal uppercase text-[clamp(2.2rem,5vw,4rem)] leading-[1.05] tracking-[-0.01em] text-[#1a1a18]">
        Selected <span class="text-accent">Success Stories</span>
      </h2>
    </div>

    <!-- Pure CSS Layout Container -->
    <div 
      id="studies-main-container"
      class="flex flex-row md:grid md:grid-cols-2 overflow-x-auto md:overflow-visible snap-x snap-mandatory no-scrollbar gap-4 md:gap-6 -mx-4 px-4 md:mx-0 md:px-0 w-screen sm:w-auto"
    >
      {caseStudies.map((study) => (
        <div 
          class:list={[
            "study-card group snap-center flex-shrink-0 w-[74vw] md:w-full bg-white md:bg-[#e3e3e1]/50 border border-transparent rounded-[20px] overflow-hidden transition-all duration-500 flex flex-col",
            study.isWide ? "md:h-[600px] md:col-span-2" : "md:h-[680px] md:col-span-1"
          ]}
          data-id={study.id}
        >
          <!-- Image Area -->
          <div class:list={[
            "image-trigger relative w-full overflow-hidden flex-shrink-0 transition-all duration-500 ease-in-out h-[280px]",
            study.isWide 
              ? "md:h-[600px] md:group-[.active]:h-[330px]" // Perfect 330px/270px visual split on hover
              : "md:h-[680px] md:group-[.active]:h-[340px]"
          ]}>
            <Image 
              src={images[study.imagePath]()} 
              alt={study.brand}
              class="absolute inset-0 w-full h-full object-cover grayscale-[20%] md:group-hover:grayscale-0 transition-all duration-500 md:group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-black/40 md:bg-black/35 group-hover:bg-black/20 transition-colors duration-500"></div>
            
            <!-- Logo Overlay -->
            <div class="absolute inset-0 flex items-center justify-center p-8">
              <Image 
                src={images[study.logoPath]()} 
                alt={`${study.brand} logo`}
                class:list={[
                  "w-full h-auto object-contain brightness-0 invert opacity-90",
                  study.isFrog ? "max-w-[180px] md:max-w-[215px]" : "max-w-[120px] md:max-w-[145px]" 
                ]}
              />
            </div>
          </div>

          <!-- Content Drawer -->
          <div class:list={[
            "card-drawer bg-white overflow-hidden transition-all duration-500 ease-in-out flex-grow opacity-100 max-h-none",
            study.isWide
              ? "md:max-h-0 md:opacity-0 md:group-[.active]:max-h-[270px] md:group-[.active]:opacity-100" // Restored space to 270px
              : "md:max-h-0 md:opacity-0 md:group-[.active]:max-h-[340px] md:group-[.active]:opacity-100"
          ]}>
            <div class="p-6 md:p-8 border-t border-[#e0dedd] h-full flex flex-col justify-between">
              <div>
                <h3 class="font-oswald text-[1.25rem] md:text-[1.5rem] uppercase mb-2 text-[#1a1a18] tracking-wide">{study.brand}</h3>
                <p class="font-inconsolata text-[0.88rem] md:text-[0.92rem] leading-relaxed text-[#6b6b65]">
                  {study.description}
                </p>
              </div>
              
              <div class="grid grid-cols-3 gap-2 border-t border-[#e0dedd] pt-4 mt-4 md:pt-6 md:mt-6">
                {study.metrics.map(metric => (
                  <div>
                    <div class="font-oswald text-[1.4rem] md:text-[2.2rem] text-[#1a1a18] leading-none mb-1">{metric.value}</div>
                    <div class="font-inconsolata text-[0.6rem] md:text-[0.68rem] uppercase tracking-wider text-[#6b6b65] leading-tight">
                      {metric.label}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function setupCaseStudies() {
    const isMobile = window.matchMedia("(max-width: 768px)").matches;
    if (isMobile) return;

    const cards = document.querySelectorAll('.study-card');

    cards.forEach(card => {
      const trigger = card.querySelector('.image-trigger');
      trigger?.addEventListener('mouseenter', () => {
        cards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');
      });
      card.addEventListener('mouseleave', () => {
        card.classList.remove('active');
      });
    });
  }

  setupCaseStudies();
  document.addEventListener('astro:after-swap', setupCaseStudies);
</script>

<style>
  .font-inconsolata {
    font-family: "Inconsolata", "Courier New", monospace;
  }
  .font-oswald {
    font-family: "Oswald", sans-serif;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>