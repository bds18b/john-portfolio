---
// CaseStudies.astro
import { Image } from "astro:assets";
import highlandLogo from "../assets/Highland-logo.svg";
import survivalFrogLogo from "../assets/SurvivalFrog-logo.webp";
import fealsLogo from "../assets/Feals-logo.svg";
import highlandScreen from "../assets/Highland-Website.png";
import survivalFrogScreen from "../assets/SurvivalFrog-Website.png";
import fealsScreen from "../assets/Feals-Website.png";

const cases = [
  {
    logo: highlandLogo,
    logoAlt: "Highland",
    screen: highlandScreen,
    screenAlt: "Highland email campaign",
    tag: "Apparel",
    result: "+38%",
    resultLabel: "Repeat purchase rate",
    copy: "Rebuilt post-purchase flow from scratch — 5-touch LTV sequence that compounded revenue over 60 days.",
  },
  {
    logo: survivalFrogLogo,
    logoAlt: "Survival Frog",
    screen: survivalFrogScreen,
    screenAlt: "Survival Frog win-back campaign",
    tag: "DTC / Preparedness",
    result: "$340k",
    resultLabel: "Win-back revenue",
    copy: "Reactivated 180k lapsed customers with a 4-stage win-back system and dynamic product recommendations.",
  },
  {
    logo: fealsLogo,
    logoAlt: "Feals",
    screen: fealsScreen,
    screenAlt: "Feals retention campaign",
    tag: "CBD / Wellness",
    result: "3.2×",
    resultLabel: "LTV increase",
    copy: "Audited broken subscription flows and rebuilt segmentation logic across the full lifecycle.",
  },
];
---

<section
  id="work"
  class="bg-[#efefed] py-[clamp(80px,12vw,160px)] px-[clamp(16px,6vw,48px)] overflow-hidden"
>
  <div class="max-w-[900px] mx-auto">

    <!-- Header -->
    <p class="font-inconsolata text-[0.75rem] font-bold tracking-[0.18em] uppercase text-accent mb-4 text-center sm:text-left">
      Case Studies
    </p>
    <h2 class="font-oswald font-normal uppercase text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.05] tracking-[-0.01em] text-[#1a1a18] mb-[clamp(48px,8vw,80px)] text-center sm:text-left">
      Work that<br /><span class="text-accent">moved the needle.</span>
    </h2>

    <!-- Three columns -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-10 gap-y-16">
      {cases.map((c, i) => (
        <div
          class="case-item flex flex-col items-center sm:items-start gap-7"
          style={`animation-delay: ${i * 100}ms`}
        >
          <!-- Phone mockup -->
          <div class="phone-frame">
            <div class="notch"></div>
            <img
              src={c.screen.src}
              alt={c.screenAlt}
              width={c.screen.width}
              height={c.screen.height}
              loading="lazy"
              decoding="async"
              class="screen-img"
            />
            <div class="home-bar"></div>
          </div>

          <!-- Logo -->
          <Image
            src={c.logo}
            alt={c.logoAlt}
            width={100}
            height={28}
            class="h-6 w-auto object-contain object-left opacity-50"
          />

          <div class="w-8 h-px bg-[#c8c8c4]"></div>

          <!-- Stat -->
          <div>
            <p class="font-oswald text-[2.6rem] leading-none text-accent">{c.result}</p>
            <p class="font-inconsolata text-[0.68rem] font-bold uppercase tracking-[0.16em] text-[#9a9a92] mt-1">{c.resultLabel}</p>
          </div>

          <!-- Copy -->
          <p class="font-inconsolata text-[0.82rem] leading-[1.7] text-[#6b6b65]">
            {c.copy}
          </p>

          <span class="font-inconsolata text-[0.65rem] font-bold tracking-[0.2em] uppercase text-[#b0b0a8]">
            {c.tag}
          </span>
        </div>
      ))}
    </div>

    <!-- Footer CTA -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 mt-[clamp(48px,8vw,80px)] pt-10 border-t border-[#d4d4d0]">
      <p class="font-inconsolata text-[0.82rem] leading-[1.6] text-[#6b6b65] max-w-[380px] border-l-2 border-accent pl-4">
        Results vary by brand, stack, and starting point. These reflect real engagements.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center gap-3 bg-accent font-inconsolata text-[0.8rem] font-bold tracking-[0.12em] uppercase text-white no-underline px-7 py-4 rounded transition-all duration-200 hover:-translate-y-1 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-[#efefed] group whitespace-nowrap"
      >
        Work with me
        <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  .font-inconsolata { font-family: "Inconsolata", "Courier New", monospace; }
  .font-oswald      { font-family: "Oswald", sans-serif; }

  /* Phone frame — border wraps the full natural image */
  .phone-frame {
    width: 160px;
    background: #fff;
    border: 5px solid #1a1a18;
    border-radius: 26px;
    padding: 10px 5px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.13);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .notch {
    width: 44px;
    height: 7px;
    background: #1a1a18;
    border-radius: 99px;
    flex-shrink: 0;
  }

  .home-bar {
    width: 44px;
    height: 4px;
    background: #d4d4d0;
    border-radius: 99px;
    flex-shrink: 0;
  }

  /* Full image — no height, no clipping, renders at 100% natural size */
  .screen-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 3px;
  }

  .case-item {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-item { opacity: 1; transform: none; animation: none; }
  }
</style>