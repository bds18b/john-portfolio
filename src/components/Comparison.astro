---
// Agencies vs working with John, as two halves side by side: the agency
// side on the page grey, John's side on the accent blue. The rows line up
// across the halves (each half is a subgrid of the same six rows), so each
// topic sits level with its counterpart even when one side wraps longer.
//
// Phones and tablets (under 900px) get a separate, shorter version
// (.pairs): the heading, then one blue block where each topic pairs the
// agency answer (faded, struck through) with John's (bold) right under it.
// Only one of the two versions is ever displayed. The older stacked phone
// layout's styles are still below (.panel rules outside the media query);
// to go back to it, delete .pairs and the display rules that swap them.
const topics = [
    {
        label: "Strategy",
        them: "A cookie-cutter playbook.",
        me: "A strategy built for your brand.",
    },
    {
        label: "Financial literacy",
        them: "No grasp of unit economics.",
        me: "Fluent in financial and unit economics.",
    },
    {
        label: "Team",
        them: "A junior account manager.",
        me: "You work directly with me.",
    },
];
---

<section id="comparison" class="compare-section">
  <div class="compare">
    <div class="panel panel-them">
        <h2 class="panel-head head-them">
            I am not an <span class="text-accent">email & SMS agency</span>
        </h2>
        <h3 class="panel-label">Email & SMS agencies</h3>
        <dl class="rows">
            {
                topics.map((t) => (
                    <div class="row">
                        <dt>{t.label}</dt>
                        <dd>{t.them}</dd>
                    </div>
                ))
            }
        </dl>
        <p class="panel-foot">
            Most agencies run on volume: templated flows and vanity metrics to
            justify a retainer.
        </p>
    </div>

    <div class="panel panel-me">
        <p class="panel-head head-me">
            I embed inside your operations and tie retention directly to
            profitable growth.
        </p>
        <h3 class="panel-label">Working with me</h3>
        <dl class="rows">
            {
                topics.map((t) => (
                    <div class="row">
                        <dt>{t.label}</dt>
                        <dd>{t.me}</dd>
                    </div>
                ))
            }
        </dl>
        <p class="panel-foot">
            You aren't buying outsourced labor. You're getting an advisor who
            owns the strategy, the execution and the financial outcomes.
        </p>
    </div>
  </div>

  <!-- Phones and tablets: each agency answer paired with John's. -->
  <div class="pairs">
    <h2 class="pairs-head">
      I am not an <span class="text-accent">email & SMS agency</span>
    </h2>
    <p class="pairs-intro">
      Most agencies run on volume: templated flows and vanity metrics to
      justify a retainer.
    </p>
    <div class="pairs-block">
      <p class="pairs-lead">
        I embed inside your operations and tie retention directly to
        profitable growth.
      </p>
      <dl class="pairs-rows">
        {
          topics.map((t) => (
            <div class="pair">
              <dt>{t.label}</dt>
              <dd class="pair-them">
                <span class="sr-only">Email and SMS agencies: </span>
                {t.them}
              </dd>
              <dd class="pair-me">
                <span class="sr-only">Working with me: </span>
                {t.me}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="pairs-foot">
        You aren't buying outsourced labor. You're getting an advisor who owns
        the strategy, the execution and the financial outcomes.
      </p>
    </div>
  </div>
</section>

<style>
    /* This section comes straight after the hero, so it carries on the
       hero's film grain: full strength at the top, where the hero leaves off,
       then fading evenly to nothing at the middle of the section. (The blue
       block covers it on the right.) */
    .compare-section {
        position: relative;
        isolation: isolate;
        padding-block: var(--section-space);
        background: #efefed;
    }
    .compare-section::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: url("../assets/hero-grain.png") repeat;
        background-size: 160px 160px;
        -webkit-mask-image: linear-gradient(to bottom, #000, rgb(0 0 0 / 0.8) 12%, rgb(0 0 0 / 0.55) 25%, rgb(0 0 0 / 0.3) 37%, rgb(0 0 0 / 0.1) 45%, transparent 50%);
        mask-image: linear-gradient(to bottom, #000, rgb(0 0 0 / 0.8) 12%, rgb(0 0 0 / 0.55) 25%, rgb(0 0 0 / 0.3) 37%, rgb(0 0 0 / 0.1) 45%, transparent 50%);
    }

    /* Same page width and side padding as the hero and nav; the blue half is
       a rounded block inside that padding, like the footer's dark block. */
    .compare {
        display: none; /* phones and tablets use .pairs instead */
        padding-inline: 20px;
    }

    /* ---- Phones and tablets: paired answers ---------------------------- */
    .pairs {
        padding-inline: 20px;
    }
    .pairs-head {
        margin: 0;
        font-family: "Unbounded", sans-serif;
        font-weight: 800;
        font-size: clamp(1.75rem, 6.4vw, 2.4rem);
        line-height: 1.05;
        letter-spacing: -0.015em;
        text-transform: uppercase;
        text-wrap: balance;
        color: #151515;
    }
    .pairs-intro {
        margin: 14px 0 28px;
        max-width: 34rem;
        font-family: "Inter", sans-serif;
        font-size: 0.97rem;
        line-height: 1.6;
        color: #444;
    }
    .pairs-block {
        padding: 36px 24px 32px;
        border-radius: 20px;
        background: #151515;
        color: #fff;
    }
    .pairs-lead {
        margin: 0 0 10px;
        font-family: "Unbounded", sans-serif;
        font-weight: 800;
        font-size: clamp(1.2rem, 5vw, 1.6rem);
        line-height: 1.15;
        letter-spacing: -0.015em;
        text-wrap: balance;
    }
    .pairs-rows {
        margin: 0;
    }
    .pair {
        padding: 22px 0;
        border-bottom: 1px solid rgb(255 255 255 / 0.18);
    }
    .pair:first-child {
        border-top: 1px solid rgb(255 255 255 / 0.18);
        margin-top: 18px;
    }
    .pair dt {
        margin-bottom: 10px;
        font-family: "Inter", sans-serif;
        font-weight: 600;
        font-size: 11px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgb(255 255 255 / 0.8);
    }
    /* The agency answer: small, faded and struck through. */
    .pair-them {
        margin: 0 0 6px;
        font-family: "Inter", sans-serif;
        font-size: 0.95rem;
        line-height: 1.45;
        color: rgb(255 255 255 / 0.62);
        text-decoration: line-through;
        text-decoration-color: rgb(255 255 255 / 0.5);
    }
    /* John's answer: bold and blue, set like the desktop rows. At least
       1.17rem (18.7px) so the blue on black counts as large text for
       contrast (3.3:1, where large bold text needs 3:1). */
    .pair-me {
        margin: 0;
        font-family: "Unbounded", sans-serif;
        font-weight: 700;
        font-size: clamp(1.17rem, 4.4vw, 1.25rem);
        color: var(--color-accent);
        line-height: 1.25;
        letter-spacing: -0.015em;
    }
    .pairs-foot {
        margin: 22px 0 0;
        font-family: "Inter", sans-serif;
        font-size: 0.95rem;
        line-height: 1.6;
        color: rgb(255 255 255 / 0.92);
    }

    /* Phones: the section's own spacing does the work above and below; the
       grey half just leaves a gap before the blue block. */
    .panel {
        --line: rgb(21 21 21 / 0.14);
    }
    .panel-them {
        padding-bottom: 48px;
        color: #151515;
    }
    .panel-me {
        --line: rgb(255 255 255 / 0.32);
        padding: 44px 24px;
        border-radius: 20px;
        background: var(--color-accent);
        color: #fff;
    }

    /* Headlines */
    .panel-head {
        margin: 0 0 clamp(36px, 8vw, 140px);
        font-family: "Unbounded", sans-serif;
        font-weight: 800;
        letter-spacing: -0.015em;
        text-wrap: balance;
    }
    .head-them {
        font-size: clamp(1.75rem, 3.1vw, 2.9rem);
        line-height: 1.05;
        text-transform: uppercase;
    }
    .head-me {
        font-size: clamp(1.35rem, 2.3vw, 2.15rem);
        line-height: 1.15;
    }

    /* Column label, with the first rule under it */
    .panel-label {
        margin: 0;
        padding-bottom: 22px;
        border-bottom: 1px solid var(--line);
        font-family: "Unbounded", sans-serif;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    /* Topic rows */
    .rows {
        margin: 0;
    }
    .row {
        padding: 30px 0 32px;
    }
    .row + .row {
        border-top: 1px solid var(--line);
    }
    .row dt {
        margin-bottom: 8px;
        font-family: "Inter", sans-serif;
        font-weight: 600;
        font-size: 11px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }
    .row dd {
        margin: 0;
        font-family: "Unbounded", sans-serif;
        font-weight: 700;
        font-size: clamp(1.05rem, 1.55vw, 1.4rem);
        line-height: 1.25;
        letter-spacing: -0.015em;
    }
    .panel-them dt {
        color: #444;
    }
    .panel-them dd {
        color: #555;
    }

    .panel-foot {
        margin: clamp(32px, 4vw, 56px) 0 0;
        max-width: 36rem;
        font-family: "Inter", sans-serif;
        font-size: 0.97rem;
        line-height: 1.65;
    }
    .panel-them .panel-foot {
        color: #444;
    }
    .panel-me .panel-foot {
        color: rgb(255 255 255 / 0.92);
    }

    /* Side by side: two halves sharing six rows (headline, label, three
       topics, closing line). */
    @media (min-width: 900px) {
        .pairs {
            display: none;
        }
        .compare {
            max-width: 1440px;
            margin-inline: auto;
            padding-inline: 48px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: repeat(6, auto);
        }
        .panel {
            padding-block: clamp(72px, 8vw, 112px);
            grid-row: 1 / span 6;
            display: grid;
            grid-template-rows: subgrid;
        }
        .rows {
            display: contents;
        }
        .panel-them {
            padding-right: 48px;
        }
        .panel-me {
            padding-inline: 48px;
            border-radius: 24px;
        }
    }
</style>
