---
// Nav.astro
---

<header
    class="site-nav fixed top-0 left-0 w-full z-50 pointer-events-none md:pointer-events-auto pt-4 px-3 md:pt-0 md:px-0"
>
    <div
        id="nav-pill"
        class="w-full mx-auto border border-[#151515]/10 bg-[#efefed]/85 backdrop-blur-sm pointer-events-auto overflow-hidden
               rounded-xl max-w-[1160px]
               md:rounded-none md:max-w-none md:border-t-0 md:border-x-0 md:border-b md:bg-[#efefed]/90"
    >
        <div
            class="flex justify-between items-center w-full px-2 py-2 md:px-12 md:py-0 md:h-20 max-w-[1440px] mx-auto"
        >
            <div class="flex items-center">
                <button
                    id="menu-toggle"
                    class="flex md:hidden border-none bg-transparent cursor-pointer group p-3 relative z-50"
                    aria-label="Toggle Menu"
                    aria-expanded="false"
                >
                    <div
                        class="flex flex-col gap-[5px] w-[18px] items-start justify-center h-4"
                    >
                        <span
                            class="w-full h-[2px] bg-[#1a1a18] rounded-full transition-all duration-300 origin-center burger-line-1"
                        ></span>
                        <span
                            class="w-[70%] h-[2px] bg-[#1a1a18] rounded-full transition-all duration-300 origin-center burger-line-2 group-hover:w-full"
                        ></span>
                    </div>
                </button>

                <nav class="hidden md:flex items-center gap-[34px]">
                    <a href="#services" class="nav-link">Services</a>
                    <a href="#case-studies" class="nav-link">Case Studies</a>
                    <a href="#testimonials" class="nav-link">Testimonials</a>
                </nav>
            </div>

            <div class="flex items-center pr-1 md:pr-0">
                <a href="#contact" class="nav-action-btn"> Contact Me </a>
            </div>
        </div>

        <div id="mobile-menu" class="md:hidden">
            <div id="mobile-menu-inner">
                <div class="mobile-divider"></div>
                <nav class="mobile-nav">
                    <a href="#services" class="mobile-link" data-index="0"
                        >Services</a
                    >
                    <a href="#case-studies" class="mobile-link" data-index="1"
                        >Case Studies</a
                    >
                    <a href="#testimonials" class="mobile-link" data-index="2"
                        >Testimonials</a
                    >
                </nav>
            </div>
        </div>
    </div>
</header>

<style>
    /* On desktop the bar has no visible edge over the hero; a hairline
       appears once the page has scrolled and content passes underneath. */
    @media (min-width: 768px) {
        #nav-pill {
            border-bottom-color: transparent;
            transition: border-color 0.2s ease;
        }
        .site-nav[data-scrolled] #nav-pill {
            border-bottom-color: rgb(21 21 21 / 0.08);
        }
    }

    .nav-link {
        font-family: "Unbounded", sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #151515;
        text-decoration: none;
        transition: color 0.2s ease-in-out;
        white-space: nowrap;
        padding: 8px 0;
    }
    .nav-link:hover {
        color: var(--color-accent, #4651f9);
    }

    .nav-action-btn {
        display: inline-flex;
        align-items: center;
        height: 38px;
        padding: 0 22px;
        border-radius: 999px;
        font-family: "Unbounded", sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        white-space: nowrap;
        color: #ffffff;
        background-color: #151515;
        text-decoration: none;
        transition: background-color 0.2s ease-in-out;
    }
    .nav-action-btn:hover {
        background-color: var(--color-accent, #4651f9);
    }
    .nav-link:focus-visible,
    .nav-action-btn:focus-visible {
        outline: 2px solid var(--color-accent, #4651f9);
        outline-offset: 3px;
    }

    /* Minimalist Close X Animation Transforms */
    [aria-expanded="true"] .burger-line-1 {
        transform: translateY(3.5px) rotate(-45deg);
    }
    [aria-expanded="true"] .burger-line-2 {
        width: 100% !important;
        transform: translateY(-3.5px) rotate(45deg);
    }

    /* Mobile menu wrapper structural dynamic sheet engine */
    #mobile-menu {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #mobile-menu.is-open {
        grid-template-rows: 1fr;
    }
    #mobile-menu-inner {
        overflow: hidden;
    }

    .mobile-divider {
        margin: 0 16px;
        height: 1px;
        background: rgba(26, 26, 24, 0.08);
    }

    .mobile-nav {
        display: flex;
        flex-direction: column;
        padding: 6px 4px;
    }

    .mobile-link {
        font-family: "Unbounded", sans-serif;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #151515;
        text-decoration: none;
        padding: 12px 16px;
        display: block;
        opacity: 0;
        transform: translateY(-4px);
        transition:
            opacity 0.25s ease,
            transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
            color 0.2s ease;
    }
    .mobile-link:hover {
        color: var(--color-accent, #6b6b65);
    }

    #mobile-menu.is-open .mobile-link {
        opacity: 1;
        transform: translateY(0);
    }
    #mobile-menu.is-open .mobile-link[data-index="0"] {
        transition-delay: 0.05s;
    }
    #mobile-menu.is-open .mobile-link[data-index="1"] {
        transition-delay: 0.1s;
    }
    #mobile-menu.is-open .mobile-link[data-index="2"] {
        transition-delay: 0.15s;
    }
</style>

<script>
    const initMenu = () => {
        const menuToggle = document.getElementById("menu-toggle");
        const mobileMenu = document.getElementById("mobile-menu");
        const mobileLinks = document.querySelectorAll(".mobile-link");

        if (!menuToggle || !mobileMenu) return;

        function toggleMenu() {
            const isOpen = mobileMenu.classList.contains("is-open");
            mobileMenu.classList.toggle("is-open", !isOpen);
            menuToggle.setAttribute("aria-expanded", String(!isOpen));
        }

        function closeMenu() {
            mobileMenu.classList.remove("is-open");
            menuToggle.setAttribute("aria-expanded", "false");
        }

        menuToggle.addEventListener("click", (e) => {
            e.stopPropagation();
            toggleMenu();
        });

        mobileLinks.forEach((link) =>
            link.addEventListener("click", closeMenu),
        );
    };

    initMenu();
    document.addEventListener("astro:page-load", initMenu);

    // Marks the header once the page has scrolled (shows the desktop hairline).
    const siteNav = document.querySelector<HTMLElement>(".site-nav");
    const markScrolled = () =>
        siteNav?.toggleAttribute("data-scrolled", window.scrollY > 8);
    markScrolled();
    window.addEventListener("scroll", markScrolled, { passive: true });
</script>
