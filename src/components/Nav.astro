---
// Nav.astro
// Fonts: Oswald (Brand) · Inconsolata (Links)
// Styling: Tailwind CSS + minimal <style> for unique transitions
---

<header
    id="floating-nav"
    class="fixed top-0 left-0 w-full z-50 px-6 pt-8 pb-4 transition-all duration-300 ease-in-out"
>
    <div
        class="max-w-[1400px] mx-auto flex justify-between items-center relative"
    >
        <!-- Brand / Name (Full name, unbolded uppercase) -->
        <a
            href="#"
            class="font-oswald text-[1.25rem] font-normal uppercase tracking-[0.05em] text-[#1a1a18] z-50 mix-blend-difference"
        >
            John Narducci
        </a>

        <!-- Desktop Navigation: Floating Center Dock (Kept blur pill for contrast over text) -->
        <nav
            class="hidden md:flex items-center gap-1 bg-[#efefed]/80 backdrop-blur-md border border-[#1a1a18]/5 p-1.5 rounded-full shadow-[0_8px_30px_rgba(0,0,0,0.04)] absolute left-1/2 -translate-x-1/2"
        >
            <a href="#services" class="nav-link">Services</a>
            <a href="#case-studies" class="nav-link">Case Studies</a>
            <a href="#testimonials" class="nav-link">Testimonials</a>
        </nav>

        <!-- Desktop Right: LinkedIn & CTA (Stripped background, borders, and shadows) -->
        <div class="hidden md:flex items-center gap-6 z-50">
            <a
                href="https://www.linkedin.com/in/john-narducci-b30540185/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#6b6b65] hover:text-[#1a1a18] transition-colors duration-200 py-2"
                aria-label="LinkedIn"
            >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path
                        d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                    ></path>
                </svg>
            </a>
            <a
                href="#contact"
                class="bg-[#1a1a18] text-[#efefed] font-inconsolata text-xs font-bold uppercase tracking-wider px-5 py-2.5 rounded transition-all duration-200 hover:bg-[#50e3b8] hover:text-[#1a1a18]"
            >
                Let's Talk
            </a>
        </div>

        <!-- Mobile Menu Button (Stripped pill styles) -->
        <button
            id="mobile-menu-toggle"
            class="md:hidden z-50 flex flex-col justify-center items-end w-10 h-10 gap-[6px] focus:outline-none"
            aria-label="Toggle Menu"
        >
            <span
                class="hamburger-line origin-center transition-all duration-300 w-5 h-[1.5px] bg-[#1a1a18]"
            ></span>
            <span
                class="hamburger-line origin-center transition-all duration-300 w-4 h-[1.5px] bg-[#1a1a18]"
            ></span>
        </button>

        <!-- Mobile Fullscreen Overlay -->
        <div
            id="mobile-overlay"
            class="fixed inset-0 bg-[#efefed] z-40 flex flex-col justify-between px-8 pt-36 pb-12 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] opacity-0 pointer-events-none translate-y-4"
        >
            <!-- Navigation Links -->
            <nav class="flex flex-col gap-6 text-left">
                <a href="#services" class="mobile-nav-link">[ 01 ] Services</a>
                <a href="#case-studies" class="mobile-nav-link"
                    >[ 02 ] Case Studies</a
                >
                <a href="#testimonials" class="mobile-nav-link"
                    >[ 03 ] Testimonials</a
                >
                <a href="#contact" class="mobile-nav-link">[ 04 ] Contact</a>
            </nav>

            <!-- Footer Elements inside Mobile Menu -->
            <div class="flex flex-col gap-6 border-t border-[#1a1a18]/10 pt-6">
                <div class="flex justify-between items-center">
                    <p
                        class="font-inconsolata text-xs uppercase tracking-wider text-[#6b6b65]"
                    >
                        Let's connect
                    </p>
                    <a
                        href="https://linkedin.com/in/YOUR_PROFILE"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-2 font-inconsolata text-sm text-[#1a1a18] font-bold"
                    >
                        LinkedIn
                        <svg
                            class="w-3.5 h-3.5 fill-current"
                            viewBox="0 0 24 24"
                            ><path
                                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                            ></path></svg
                        >
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<style>
    .font-inconsolata {
        font-family: "Inconsolata", "Courier New", monospace;
    }
    .font-oswald {
        font-family: "Oswald", sans-serif;
    }

    /* Desktop Link Styling */
    .nav-link {
        font-family: "Inconsolata", monospace;
        font-size: 0.85rem;
        font-weight: 500;
        color: #6b6b65;
        padding: 0.5rem 1.25rem;
        border-radius: 9999px;
        transition: all 0.2s ease;
    }
    .nav-link:hover {
        color: #1a1a18;
        background-color: rgba(26, 26, 24, 0.04);
    }

    /* Mobile Link Reveal Styling */
    .mobile-nav-link {
        font-family: "Inconsolata", monospace;
        font-size: clamp(1.75rem, 6vw, 2.5rem);
        font-weight: 500;
        color: #1a1a18;
        text-decoration: none;
        transition:
            transform 0.3s ease,
            color 0.2s ease;
        display: inline-block;
    }
    .mobile-nav-link:hover {
        color: #50e3b8;
        transform: translateX(8px);
    }

    /* Active States for Hamburgers */
    .menu-open .hamburger-line:first-child {
        transform: translateY(4px) rotate(45deg);
        width: 20px;
    }
    .menu-open .hamburger-line:last-child {
        transform: translateY(-4px) rotate(-45deg);
        width: 20px;
    }

    /* Active State for Mobile Overlay */
    .menu-open #mobile-overlay {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }

    /* Scroll interaction: moves layout tightly down into view */
    .nav-scrolled {
        padding-top: 1.25rem;
        padding-bottom: 0.5rem;
    }
</style>

<script>
    function setupNavigation() {
        const nav = document.getElementById("floating-nav");
        const toggleBtn = document.getElementById("mobile-menu-toggle");
        const mobileLinks = document.querySelectorAll(".mobile-nav-link");

        // Scroll Compression
        window.addEventListener("scroll", () => {
            if (window.scrollY > 40) {
                nav?.classList.add("nav-scrolled");
            } else {
                nav?.classList.remove("nav-scrolled");
            }
        });

        function toggleMenu() {
            nav?.classList.toggle("menu-open");
            document.body.classList.toggle("overflow-hidden");
        }

        toggleBtn?.addEventListener("click", toggleMenu);

        mobileLinks.forEach((link) => {
            link.addEventListener("click", () => {
                nav?.classList.remove("menu-open");
                document.body.classList.remove("overflow-hidden");
            });
        });
    }

    setupNavigation();
    document.addEventListener("astro:page-load", setupNavigation);
</script>
