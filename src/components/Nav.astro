---
// Nav.astro
---

<header
    class="fixed top-0 left-0 w-full z-50 pt-[24px] px-[clamp(16px,4vw,48px)] pointer-events-none"
>
    <div
        id="nav-pill"
        class="max-w-[900px] bg-white backdrop-blur-md rounded-md mx-auto flex flex-col w-full pointer-events-auto overflow-hidden"
    >
        <!-- Main row -->
        <div class="flex justify-between items-center w-full">
            <!-- Mobile: Burger -->
            <button
                id="menu-toggle"
                class="flex md:!hidden border-none bg-transparent cursor-pointer group z-50 nav-link-pad"
                aria-label="Toggle Menu"
                aria-expanded="false"
            >
                <div
                    class="flex flex-col gap-[5px] w-[18px] items-start justify-center"
                >
                    <span
                        class="w-full h-[2px] bg-[#1a1a18] rounded-full transition-all duration-300 origin-center burger-line-1"
                    ></span>
                    <span
                        class="w-[70%] h-[2px] bg-[#1a1a18] rounded-full transition-all duration-300 origin-center burger-line-2 group-hover:w-full"
                    ></span>
                </div>
            </button>

            <!-- Desktop: Nav links -->
            <nav class="hidden md:flex items-center">
                <a href="#services" class="nav-link">Services</a>
                <span class="nav-sep" aria-hidden="true">|</span>
                <a href="#case-studies" class="nav-link">Case Studies</a>
                <span class="nav-sep" aria-hidden="true">|</span>
                <a href="#testimonials" class="nav-link">Testimonials</a>
            </nav>

            <!-- Contact Me -->
            <a href="#contact" class="nav-link">Contact Me</a>
        </div>

        <!-- Mobile expanded menu -->
        <div id="mobile-menu" class="md:hidden">
            <div id="mobile-menu-inner">
                <div class="mobile-divider"></div>
                <nav class="mobile-nav">
                    <a href="#services" class="mobile-link" data-index="0"
                        >Services</a
                    >
                    <a href="#case-studies" class="mobile-link" data-index="1"
                        >Case Studies</a
                    >
                    <a href="#testimonials" class="mobile-link" data-index="2"
                        >Testimonials</a
                    >
                    <a href="#contact" class="mobile-link" data-index="3"
                        >Contact Me</a
                    >
                </nav>
            </div>
        </div>
    </div>
</header>

<style>
    .nav-link,
    .nav-link-pad {
        padding: 10px 20px;
        display: inline-flex;
        align-items: center;
    }

    .nav-link {
        font-family: "Inconsolata", "Courier New", monospace;
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #1a1a18;
        text-decoration: none;
        transition: color 0.2s;
        white-space: nowrap;
    }
    .nav-link:hover {
        color: var(--color-accent, #6b6b65);
    }

    .nav-sep {
        color: #e2e2de;
        font-family: "Inconsolata", "Courier New", monospace;
        font-size: 0.8rem;
        padding: 0 2px;
        user-select: none;
    }

    /* Burger → X */
    [aria-expanded="true"] .burger-line-1 {
        transform: translateY(3.5px) rotate(-45deg);
    }
    [aria-expanded="true"] .burger-line-2 {
        width: 100% !important;
        transform: translateY(-3.5px) rotate(45deg);
    }

    /* ── Mobile expanded panel ── */
    #mobile-menu {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    #mobile-menu.is-open {
        grid-template-rows: 1fr;
    }
    #mobile-menu-inner {
        overflow: hidden;
    }

    .mobile-divider {
        margin: 0 20px;
        height: 1px;
        background: #e8e8e4;
    }

    .mobile-nav {
        display: flex;
        flex-direction: column;
        padding: 8px 0;
    }

    .mobile-link {
        font-family: "Inconsolata", "Courier New", monospace;
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #1a1a18;
        text-decoration: none;
        padding: 10px 20px;
        display: block;
        opacity: 0;
        transform: translateY(-6px);
        transition:
            opacity 0.3s ease,
            transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
            color 0.2s ease;
    }
    .mobile-link:hover {
        color: var(--color-accent, #6b6b65);
    }

    #mobile-menu.is-open .mobile-link {
        opacity: 1;
        transform: translateY(0);
    }
    #mobile-menu.is-open .mobile-link[data-index="0"] {
        transition-delay: 0.1s;
    }
    #mobile-menu.is-open .mobile-link[data-index="1"] {
        transition-delay: 0.15s;
    }
    #mobile-menu.is-open .mobile-link[data-index="2"] {
        transition-delay: 0.2s;
    }
    #mobile-menu.is-open .mobile-link[data-index="3"] {
        transition-delay: 0.25s;
    }
</style>

<script>
    const initMenu = () => {
        const menuToggle = document.getElementById("menu-toggle");
        const mobileMenu = document.getElementById("mobile-menu");
        const mobileLinks = document.querySelectorAll(".mobile-link");

        if (!menuToggle || !mobileMenu) return;

        function toggleMenu() {
            const isOpen = mobileMenu.classList.contains("is-open");
            mobileMenu.classList.toggle("is-open", !isOpen);
            menuToggle.setAttribute("aria-expanded", String(!isOpen));
            document.body.style.overflow = !isOpen ? "hidden" : "";
        }

        function closeMenu() {
            mobileMenu.classList.remove("is-open");
            menuToggle.setAttribute("aria-expanded", "false");
            document.body.style.overflow = "";
        }

        menuToggle.addEventListener("click", toggleMenu);
        mobileLinks.forEach((link) =>
            link.addEventListener("click", closeMenu),
        );
    };

    initMenu();
    document.addEventListener("astro:page-load", initMenu);
</script>
