---
import { Image } from "astro:assets";
import portrait from "../assets/john-with-dog.jpg";
import fealsLogo from "../assets/Feals-logo.svg";
import highlandLogo from "../assets/Highland-logo.svg";
import survivalFrogLogo from "../assets/SurvivalFrog-logo.webp";

// Background and approach are taken from John's LinkedIn About section.
// Name and LinkedIn: linkedin.com/in/john-narducci-b30540185
//
// Set like the hero: a collage of cards on a dot grid beside the words. The
// pieces are John's photo, his career as a short timeline, and the section's
// key idea as a small chart (with retention, a brand can afford a higher
// CAC without giving up margin), with an icon tile beside them. The cards
// only restate the words, so they are hidden from screen readers; the photo
// keeps its description.
//
// Wide screens (900px+): the collage on the left, the words on the right,
// set big so they fill about as much room as the collage. Phones and
// tablets: the collage, then the words: three short groups in one size,
// spaced apart (who John works with; his background, with Feals as its
// logo; and the idea behind it).
// As the section scrolls up the screen they darken word by word, from faint
// to full (data-scrub, the script below).
//
// The pieces come in when the section scrolls into view (data-reveal=
// "pieces", see src/scripts/reveal.ts): until then their animations wait
// at the start, then run on the timeline in the styles below.
---

<section id="about" class="about">
    <div class="about-inner">
        <div class="about-visual">
            <div class="about-collage" data-reveal="pieces">
                <!-- John's photo, in a white frame, tilted. -->
                <figure class="piece photo-john" style="--n: 0">
                    <Image
                        src={portrait}
                        alt="John Narducci in the snow, holding his dog"
                        widths={[400, 600, 800]}
                        sizes="(min-width: 900px) 340px, 58vw"
                        quality={90}
                        class="john-img"
                    />
                </figure>

                <!-- Career: a timeline, most recent first. Now fractional, for
                     Feals and Highland; before that in-house at Feals, and
                     before Feals at Survival Frog. Every row is the role, with
                     the company (or companies) small and grey under it. -->
                <div class="piece career" style="--n: 1" aria-hidden="true">
                    <span class="card-head"><b>Career</b> · 5–6 years brand-side</span>
                    <ol class="career-steps">
                        <li class="career-step is-now" style="--s: 0">
                            <span class="career-main">
                                <span class="career-role">Fractional retention lead</span>
                                <span class="career-orgs">
                                    <Image src={fealsLogo} alt="" width={64} class="org-logo org-feals" />
                                    <span class="org"
                                        ><Image src={highlandLogo} alt="" width={40} class="org-logo org-highland" />Highland</span
                                    >
                                </span>
                            </span>
                            <span class="career-tag tag-now">Now</span>
                        </li>
                        <li class="career-step" style="--s: 1">
                            <span class="career-main">
                                <span class="career-role">Retention lead</span>
                                <span class="career-orgs">
                                    <Image src={fealsLogo} alt="" width={64} class="org-logo org-feals" />
                                </span>
                            </span>
                        </li>
                        <li class="career-step" style="--s: 2">
                            <span class="career-main">
                                <span class="career-role">Growth &amp; retention</span>
                                <span class="career-orgs">
                                    <span class="org"
                                        ><Image src={survivalFrogLogo} alt="" width={120} class="org-logo org-frog" />Survival Frog</span
                                    >
                                </span>
                            </span>
                        </li>
                    </ol>
                </div>

                <span class="piece tile tile-loop" style="--n: 2" aria-hidden="true">
                    <svg viewBox="0 0 24 24"
                        ><path d="m17 2 4 4-4 4" /><path d="M3 11v-1a4 4 0 0 1 4-4h14" /><path d="m7 22-4-4 4-4" /><path
                            d="M21 13v1a4 4 0 0 1-4 4H3"></path></svg
                    >
                </span>

                <!-- The key idea: retention raises the CAC a brand can afford. -->
                <div class="piece room" style="--n: 3" aria-hidden="true">
                    <span class="card-head"><b>Max CAC you can afford</b></span>
                    <span class="room-row" style="--b: 0">
                        <span class="room-label">Acquisition only</span>
                        <span class="room-track"><span class="room-bar room-bar-base"></span></span>
                    </span>
                    <span class="room-row" style="--b: 1">
                        <span class="room-label">With retention</span>
                        <span class="room-track"><span class="room-bar room-bar-retention"></span></span>
                    </span>
                    <span class="room-badge">Without giving up margin</span>
                </div>

            </div>
        </div>

        <div class="about-copy" data-scrub>
            <h2 class="about-statement">
                I'm John. I work with founders and CEOs of <span class="nowrap">8-figure</span> DTC CPG brands
                who want to grow without giving up margin.
            </h2>
            <p class="about-text">
                I spent 5–6 years brand-side in growth and retention, including
                leading retention in-house at <span class="scrub-word logo-word"
                    ><Image src={fealsLogo} alt="Feals." width={200} class="inline-logo" /></span
                >
            </p>
            <p class="about-text">
                At scale, growth means being able to afford a higher CAC, and a
                lot of that room is already in the customers you've paid for.
            </p>
        </div>
    </div>
</section>

<script>
    // Scroll-linked reveal for the words: each word starts faint and darkens
    // as the block scrolls up the screen, one after another in reading
    // order, each over the space of three words, so a soft edge runs through
    // the text. It starts when the block's top is 85% of the way down the
    // screen and is done when its bottom is 40% of the way down. Words in
    // the blue keyword carry its texture themselves (a texture clipped to
    // the text doesn't reach words faded on their own). With reduced motion,
    // or without this script, the words are simply shown in full.
    //
    // Under 900px (the words under the collage) the block is also narrowed
    // to its longest line and centred: the text stays left-aligned, but its
    // ragged right edge no longer leaves more room on the right than on the
    // left. Rechecked when the fonts arrive and when the window resizes.
    document.querySelectorAll<HTMLElement>("[data-scrub]").forEach((block) => {
        const words: HTMLElement[] = [];
        const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
        const nodes: Text[] = [];
        while (walker.nextNode()) nodes.push(walker.currentNode as Text);
        for (const node of nodes) {
            const parts = node.data.split(/(\s+)/);
            if (!parts.some((part) => part.trim())) continue;
            const textured = node.parentElement?.closest(".accent-texture");
            const frag = document.createDocumentFragment();
            for (const part of parts) {
                if (!part) continue;
                if (!part.trim()) {
                    frag.append(part);
                    continue;
                }
                const word = document.createElement("span");
                word.className = "scrub-word";
                if (textured) word.classList.add("accent-texture");
                word.textContent = part;
                frag.append(word);
                words.push(word);
            }
            node.replaceWith(frag);
        }
        block.querySelectorAll(".accent-texture:not(.scrub-word)").forEach((el) => el.classList.remove("accent-texture"));
        // Everything that reveals as one word, in reading order: the words
        // made above and any set in the markup (the Feals logo).
        words.splice(0, words.length, ...block.querySelectorAll<HTMLElement>(".scrub-word"));

        const narrow = window.matchMedia("(max-width: 899px)");
        const fit = () => {
            block.style.width = "";
            if (!narrow.matches) return;
            const left = block.getBoundingClientRect().left;
            let right = left;
            words.forEach((word) => {
                right = Math.max(right, word.getBoundingClientRect().right);
            });
            if (right > left) block.style.width = `${Math.ceil(right - left) + 1}px`;
        };
        let fitting = false;
        const requestFit = () => {
            if (!fitting) {
                fitting = true;
                requestAnimationFrame(() => {
                    fitting = false;
                    fit();
                });
            }
        };
        fit();
        document.fonts?.ready.then(fit);
        window.addEventListener("resize", requestFit, { passive: true });

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        block.classList.add("is-scrub");

        const SPREAD = 3;
        let ticking = false;
        const update = () => {
            ticking = false;
            const box = block.getBoundingClientRect();
            const vh = window.innerHeight;
            const start = vh * 0.85;
            const progress = Math.min(1, Math.max(0, (start - box.top) / (vh * 0.45 + box.height)));
            const lit = progress * (words.length + SPREAD);
            words.forEach((word, i) => {
                const t = Math.min(1, Math.max(0, (lit - i) / SPREAD));
                word.style.setProperty("--lit", t.toFixed(3));
            });
        };
        const request = () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(update);
            }
        };
        window.addEventListener("scroll", request, { passive: true });
        window.addEventListener("resize", request, { passive: true });
        update();
    });
</script>

<style>
    .about {
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        padding: var(--section-space) 20px;
        background: var(--page-bg);
    }
    /* Keeps "8-figure" from breaking after the hyphen. */
    .nowrap {
        white-space: nowrap;
    }

    /* ---- Layout ----------------------------------------------------------
       Phones and tablets: the collage (running to the screen edges on
       phones), then the words. Wide screens: two equal halves, the collage
       on the left; the testimonials below use the same halves and gap, so
       the words here start on the same line as the quotes there. */
    .about-inner {
        display: grid;
        justify-items: center;
    }
    .about-visual {
        width: 100%;
        max-width: 560px;
    }
    .about-copy {
        width: 100%;
        max-width: 36rem;
        margin-top: 28px;
    }
    @media (max-width: 639px) {
        .about-visual {
            width: calc(100% + 40px);
            max-width: none;
            margin-inline: -20px;
        }
    }
    @media (min-width: 900px) {
        .about {
            padding-inline: 48px;
        }
        .about-inner {
            max-width: 1344px;
            margin-inline: auto;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: clamp(48px, 6vw, 96px);
            align-items: center;
            justify-items: stretch;
        }
        .about-visual {
            max-width: 620px;
            justify-self: center;
        }
        .about-copy {
            max-width: none;
            margin-top: 0;
        }
    }

    /* ---- Words -----------------------------------------------------------
       Three groups in one size, in ink like the hero's headline, with
       about a line's space between them. While the scroll reveal is on (.is-scrub),
       each word's opacity runs from 16% to full with its --lit (0 to 1). */
    .about-statement,
    .about-text {
        margin: 0;
        font-family: "Inter Tight", "Inter", sans-serif;
        font-weight: 600;
        font-size: clamp(1.375rem, 5.6vw, 1.875rem);
        line-height: 1.12;
        letter-spacing: -0.03em;
        color: #151515;
        text-wrap: pretty;
    }
    .about-text {
        margin-top: 1em;
    }
    @media (min-width: 900px) {
        .about-statement,
        .about-text {
            font-size: clamp(1.5rem, 2.4vw, 2.25rem);
        }
    }
    /* Feals as its logo, in the text's ink. The logo's letters stand on the
       bottom edge of the image, so the image's bottom (which is its
       baseline in a line of text) sits on the text's baseline; its height
       puts the f and l at about the height of the capitals. Its own dot
       ends the sentence. */
    .logo-word {
        white-space: nowrap;
    }
    .about-text :global(.inline-logo) {
        display: inline-block;
        width: auto;
        height: 0.74em;
        vertical-align: baseline;
        filter: brightness(0);
    }
    .is-scrub :global(.scrub-word) {
        opacity: calc(0.16 + 0.84 * var(--lit, 0));
        transition: opacity 0.2s linear;
    }

    /* ---- Collage ---------------------------------------------------------
       As in the hero: a square canvas, every piece placed and sized in cqi
       (1% of the canvas width) so the picture scales as one. --x, --y and
       --w place a piece, --r tilts it, --z stacks it. */
    .about-collage {
        --start: var(--reveal-delay, 0ms);
        --stagger: 130ms;
        position: relative;
        aspect-ratio: 1;
        container-type: inline-size;
        isolation: isolate;
        color: #151515;
        font-family: "Inter", sans-serif;
        text-align: left;
    }
    /* Dot grid, fading out towards the edges. */
    .about-collage::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: radial-gradient(circle, rgb(21 21 21 / 0.2) 1px, transparent 1.5px) 0 0 / 18px 18px;
        -webkit-mask-image: radial-gradient(ellipse at center, #000 45%, transparent 72%);
        mask-image: radial-gradient(ellipse at center, #000 45%, transparent 72%);
    }
    .piece {
        position: absolute;
        left: var(--x);
        top: var(--y);
        width: var(--w);
        z-index: var(--z, 1);
        rotate: var(--r, 0deg);
        margin: 0;
        background: #fff;
        border: 1px solid rgb(21 21 21 / 0.08);
        border-radius: 2.2cqi;
        box-shadow:
            0 1px 2px rgb(21 21 21 / 0.04),
            0 1.2cqi 3cqi -1.4cqi rgb(21 21 21 / 0.1);
    }
    .card-head {
        display: block;
        font-size: max(9px, 2.4cqi);
        line-height: 1.3;
        color: #6b6b6b;
        white-space: nowrap;
    }
    .card-head b {
        font-weight: 600;
        color: #151515;
    }

    /* The photo, in a white frame. */
    .photo-john {
        --x: 3cqi;
        --y: 9cqi;
        --w: 54cqi;
        --r: -2.5deg;
        --z: 2;
        padding: 1.4cqi;
    }
    .photo-john :global(.john-img) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        border-radius: 1.4cqi;
    }

    /* Career: dots on a line, the current role's dot in the accent. */
    .career {
        --x: 49cqi;
        --y: 3cqi;
        --w: 48cqi;
        --z: 3;
        padding: 2.6cqi 2.8cqi 2.4cqi;
    }
    /* The dots and the line share one centre. The dots are an odd number
       of whole pixels across (about 1.5cqi) and the 1px line runs down
       their middle pixel; sizes in cqi alone land between pixels and the
       line drifts off centre. */
    .career-steps {
        --half: round(down, 0.75cqi, 1px);
        position: relative;
        margin: 1.6cqi 0 0;
        padding: 0;
        list-style: none;
        font-size: max(9px, 2.5cqi);
        line-height: 1.3;
    }
    .career-steps::before {
        content: "";
        position: absolute;
        left: var(--half);
        top: 3.2cqi;
        bottom: 6.8cqi;
        width: 1px;
        background: rgb(21 21 21 / 0.16);
        transform-origin: top;
    }
    /* The current row's tag sits on the line of its role. */
    .career-step {
        position: relative;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 2cqi;
        padding: 1.5cqi 0 1.5cqi 4cqi;
        white-space: nowrap;
    }
    .career-step::before {
        content: "";
        position: absolute;
        left: 0;
        top: calc(1.5cqi + 0.65em);
        width: calc(var(--half) * 2 + 1px);
        height: calc(var(--half) * 2 + 1px);
        margin-top: calc(var(--half) * -1 - 0.5px);
        border: 1px solid rgb(21 21 21 / 0.3);
        border-radius: 50%;
        background: #fff;
        box-sizing: border-box;
    }
    .is-now::before {
        border: 0;
        background: var(--accent-fill);
        image-rendering: pixelated;
    }
    .career-role {
        font-weight: 600;
    }
    /* Under each role, the company (or, for the fractional role, the
       clients) small and grey, like the hero's logo strip. */
    .career-main {
        display: flex;
        flex-direction: column;
        gap: 0.9cqi;
    }
    .career-orgs {
        display: inline-flex;
        align-items: center;
        gap: 1.8cqi;
        font-size: max(8px, 2.1cqi);
        font-weight: 600;
        letter-spacing: -0.01em;
        opacity: 0.5;
    }
    .org {
        display: inline-flex;
        align-items: center;
        gap: 0.5cqi;
    }
    .career-orgs :global(.org-logo) {
        display: block;
        width: auto;
        filter: brightness(0);
    }
    .career-orgs :global(.org-feals) {
        height: 0.82em;
    }
    .career-orgs :global(.org-highland) {
        height: 1.3em;
    }
    /* Survival Frog's frog sits in the middle of a wide image, with empty
       space taking up 27.5% of the width on each side (the image is 1.91
       times as wide as it is tall); the negative margins take that space
       back, so the name sits as close to the frog as Highland's to its
       deer. */
    .career-orgs :global(.org-frog) {
        height: 1.4em;
        margin-inline: -0.735em;
    }
    .career-tag {
        padding: 0.5cqi 1.3cqi;
        border-radius: 999px;
        background: #f3f3f1;
        font-size: max(8px, 2cqi);
        font-weight: 500;
        color: #555;
    }
    .tag-now {
        background: rgb(70 81 249 / 0.1);
        color: var(--color-accent);
    }

    /* The key idea as two bars: the CAC a brand can afford on acquisition
       alone, and with retention. */
    .room {
        --x: 35cqi;
        --y: 61cqi;
        --w: 58cqi;
        --z: 3;
        padding: 2.6cqi 2.8cqi 3cqi;
    }
    .room-row {
        display: block;
        margin-top: 2cqi;
    }
    .room-label {
        display: block;
        margin-bottom: 0.9cqi;
        font-size: max(8px, 2.1cqi);
        line-height: 1.3;
        color: #6b6b6b;
    }
    .room-track {
        display: block;
        height: 2.4cqi;
        border-radius: 999px;
        background: #f1f1ef;
        overflow: hidden;
    }
    .room-bar {
        display: block;
        height: 100%;
        border-radius: inherit;
        transform-origin: left center;
    }
    /* Both bars in the accent texture; only their lengths differ. */
    .room-bar-base,
    .room-bar-retention {
        background: var(--accent-fill);
        image-rendering: pixelated;
    }
    .room-bar-base {
        width: 42%;
    }
    .room-bar-retention {
        width: 88%;
    }
    .room-badge {
        position: absolute;
        top: -2.4cqi;
        right: 2.6cqi;
        padding: 0.9cqi 1.6cqi;
        border-radius: 1.2cqi;
        background: #151515;
        color: #fff;
        font-size: max(8px, 2.2cqi);
        font-weight: 600;
        line-height: 1.3;
        white-space: nowrap;
        box-shadow: 0 0.8cqi 1.6cqi -0.8cqi rgb(21 21 21 / 0.18);
    }

    /* Icon tiles. */
    .tile {
        --w: 11cqi;
        aspect-ratio: 1;
        display: grid;
        place-items: center;
        border-radius: 2.6cqi;
    }
    .tile svg {
        width: 46%;
        height: 46%;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .tile-loop {
        --x: 84cqi;
        --y: 47cqi;
        color: var(--color-accent);
    }

    /* ---- Motion ----------------------------------------------------------
       When the collage scrolls into view (--start is when its turn comes):
         the pieces land one after another, 130ms apart, each rising, growing
         and turning into its tilt
         the career line draws down and its roles slide in one by one
         the two bars grow, the short one first, then the badge pops in
       After that the pieces bob gently, each on its own beat. Until the
       collage is in view every
       animation waits at its start (paused), so nothing runs unseen. */
    :global(html.reveal-on) .about-collage:not(.is-in) *,
    :global(html.reveal-on) .about-collage:not(.is-in) *::before {
        animation-play-state: paused !important;
    }
    .piece {
        animation:
            piece-in 1s var(--ease) calc(var(--start) + var(--n) * var(--stagger)) backwards,
            piece-bob 7s ease-in-out calc(var(--n) * -1.7s) infinite alternate;
    }
    @keyframes piece-in {
        from {
            opacity: 0;
            transform: translateY(7cqi) scale(0.92);
            rotate: calc(var(--r, 0deg) + 5deg);
        }
    }
    @keyframes piece-bob {
        from {
            translate: 0 0.6cqi;
        }
        to {
            translate: 0 -0.6cqi;
        }
    }
    .career-steps::before {
        animation: line-draw 0.9s var(--ease) calc(var(--start) + var(--stagger) + 350ms) backwards;
    }
    @keyframes line-draw {
        from {
            transform: scaleY(0);
        }
    }
    .career-step {
        animation: step-in 0.7s var(--ease) calc(var(--start) + var(--stagger) + 400ms + var(--s) * 140ms) backwards;
    }
    @keyframes step-in {
        from {
            opacity: 0;
            transform: translateX(-2cqi);
        }
    }
    .room-bar {
        animation: bar-grow 1.1s var(--ease) calc(var(--start) + 3 * var(--stagger) + 350ms + var(--b) * 160ms) backwards;
    }
    @keyframes bar-grow {
        from {
            transform: scaleX(0);
        }
    }
    .room-badge {
        animation: badge-pop 0.6s var(--ease) calc(var(--start) + 3 * var(--stagger) + 1000ms) backwards;
    }
    @keyframes badge-pop {
        from {
            opacity: 0;
            transform: translateY(1.5cqi) scale(0.9);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .piece,
        .career-steps::before,
        .career-step,
        .room-bar,
        .room-badge {
            animation: none;
        }
    }

    /* ---- Dark ------------------------------------------------------------
       Off-white type, the cards #19191c with no edge and deeper shadows,
       the dot grid, timeline and tracks in white at low opacity.
       The logos turn white; the blue stays as it is. */
    :global(:root[data-site-theme="dark"]) .about-statement,
    :global(:root[data-site-theme="dark"]) .about-text {
        color: #f5f5f2;
    }
    :global(:root[data-site-theme="dark"]) .about-text :global(.inline-logo) {
        filter: brightness(0) invert(0.96);
    }
    :global(:root[data-site-theme="dark"]) .about-collage {
        color: #f5f5f2;
    }
    :global(:root[data-site-theme="dark"]) .about-collage::before {
        background-image: radial-gradient(circle, rgb(255 255 255 / 0.14) 1px, transparent 1.5px);
    }
    :global(:root[data-site-theme="dark"]) .piece {
        background: #19191c;
        border-color: transparent;
        box-shadow:
            0 1px 2px rgb(0 0 0 / 0.4),
            0 2.4cqi 5cqi -1.6cqi rgb(0 0 0 / 0.6);
    }
    :global(:root[data-site-theme="dark"]) .card-head {
        color: #a1a1aa;
    }
    :global(:root[data-site-theme="dark"]) .card-head b {
