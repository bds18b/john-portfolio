---
import { Image } from "astro:assets";
import portrait from "../assets/john-with-dog.jpg";

// Background and approach are taken from John's LinkedIn About section.
// Name and LinkedIn: linkedin.com/in/john-narducci-b30540185
---

<section id="about" class="about">
    <div class="about-inner">
        <Image
            src={portrait}
            alt="John Narducci in the snow, holding his dog"
            widths={[400, 600, 800, 1080]}
            sizes="(min-width: 1440px) 624px, (min-width: 900px) calc(50vw - 75px), min(calc(100vw - 40px), 480px)"
            quality={90}
            class="about-photo"
        />
        <div class="about-copy">
            <h2 class="about-title">I'm John</h2>
            <p class="about-lead">
                I work with founders and CEOs of <span class="nowrap">8-figure</span> DTC CPG brands who
                want to keep growing without giving up margin to do it.
            </p>
            <p class="about-text">
                Before going fractional, I spent 5–6 years brand-side in growth
                and retention, including leading retention in-house at Feals.
                I've also sat in the growth seat, so I know what CAC pressure
                feels like from the inside.
            </p>
            <p class="about-text">
                Most brands at this stage were built to acquire customers, not
                keep them. That worked while CAC was low. At scale, the game
                isn't a lower CAC. It's being able to afford a higher one, and a
                lot of that room is already sitting in the customers you've paid
                for.
            </p>
        </div>
    </div>
</section>

<style>
    .about {
        padding: var(--section-space) 20px;
        background: #efefed;
    }
    /* Phones and tablets: the photo, then the words, left-aligned like the
       other stacked sections (centred paragraphs are hard to read). */
    .about-inner {
        max-width: 1100px;
        margin-inline: auto;
        display: grid;
        gap: 32px;
        justify-items: start;
        text-align: left;
    }
    /* Square, the photo's own shape, so nothing is cropped: full width on
       phones (up to 480px), as wide as its column on wide screens. */
    .about-inner :global(.about-photo) {
        width: 100%;
        max-width: 480px;
        height: auto;
        aspect-ratio: 1;
        object-fit: cover;
        object-position: 50% 50%;
        border-radius: 20px;
    }
    .about-copy {
        max-width: 36rem;
    }
    /* Keeps "8-figure" from breaking after the hyphen. */
    .nowrap {
        white-space: nowrap;
    }
    .about-title {
        margin: 0;
        font-family: "Unbounded", sans-serif;
        font-weight: 800;
        font-size: clamp(1.75rem, 3.6vw, 2.75rem);
        line-height: 1.05;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        color: #151515;
    }
    .about-lead {
        margin: 14px 0 0;
        font-family: "Unbounded", sans-serif;
        font-weight: 600;
        font-size: clamp(1.05rem, 1.6vw, 1.35rem);
        line-height: 1.3;
        letter-spacing: -0.01em;
        color: var(--color-accent);
        text-wrap: balance;
    }
    .about-text {
        margin: 18px 0 0;
        font-family: "Inter", sans-serif;
        font-size: 1rem;
        line-height: 1.65;
        color: #444;
    }
    .about-text + .about-text {
        margin-top: 12px;
    }

    /* Wide screens: two equal halves across the full page width, like the
       comparison: the photo fills the left half (square, the photo's own
       shape, so nothing is cropped) and the words fill the right. The
       testimonials below use the same halves and gap, so the words here start
       on the same line as the quotes there. */
    @media (min-width: 900px) {
        .about {
            padding-inline: 48px;
        }
        .about-inner {
            max-width: 1344px;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: clamp(48px, 6vw, 96px);
            align-items: center;
            justify-items: stretch;
            text-align: left;
        }
        .about-inner :global(.about-photo) {
            max-width: none;
        }
        .about-copy {
            max-width: 40rem;
        }
        .about-lead {
            font-size: clamp(1.15rem, 1.75vw, 1.5rem);
        }
    }
</style>
