        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* Channel tiles. */
    .tile {
        --w: 11cqi;
        aspect-ratio: 1;
        display: grid;
        place-items: center;
        border-radius: 2.6cqi;
    }
    .tile svg {
