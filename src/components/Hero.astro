    /* ---- Entrance --------------------------------------------------------
       One sequence on load, everything rising into place on the same easing
       as the "Work with me" fill:
         0ms     John's pill lifts out of a blur
         100ms+  the headline's words rise from below, one by one
         450ms   the paragraph, then the buttons (550)
         750ms+  the collage's pieces rise in one after another; the chart's
                 lines draw, its badge pops in (1850), the flow's steps come
                 in one by one, and each result counts up
       After that the pieces bob gently, each on its own beat. Every entrance
       animation fills "backwards": it holds its starting state during its
       delay and leaves no trace once done, so hover effects work as before.
       While html.hero-wait is set (until the fonts are in) they are held at
       the start. */
    .hero {
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
    }
    :global(html.hero-wait) .hero :global(*) {
        animation-play-state: paused !important;
    }

    .hero-rise {
        animation: hero-rise 0.9s var(--ease) var(--d, 0ms) backwards;
    }
    @keyframes hero-rise {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
    }

    /* Headline: the words rise out of their boxes a line at a time, 80ms
       apart (--l, the word's line, is set by the script; without it every
       line rises at once). */
    .w-in {
        animation: word-rise 0.9s var(--ease) calc(100ms + var(--l, 0) * 80ms) backwards;
    }
    @keyframes word-rise {
        from {
            transform: translateY(110%);
        }
    }

    /* Collage pieces rise in, then bob. The bob moves `translate` and the
       entrance `transform`, so the two never fight; each piece's bob starts
       part way through (negative delay) so they move out of step. */
    .piece {
        animation:
            piece-in 0.9s var(--ease) calc(var(--start) + var(--n) * var(--stagger)) backwards,
            piece-bob 7s ease-in-out calc(var(--n) * -1.7s) infinite alternate;
    }
    @keyframes piece-in {
        from {
            opacity: 0;
            transform: translateY(6cqi) scale(0.94);
        }
    }
    @keyframes piece-bob {
        from {
            translate: 0 0.6cqi;
        }
        to {
            translate: 0 -0.6cqi;
        }
    }
    /* The chart's lines draw from left to right (pathLength="1", so a dash
       of 1 is the whole line). */
    .chart-line {
        stroke-dasharray: 1;
        animation: line-draw 1.6s var(--ease) calc(var(--start) + 250ms) backwards;
    }
    .chart-line-compare {
        animation-delay: calc(var(--start) + 150ms);
    }
    @keyframes line-draw {
        from {
            stroke-dashoffset: 1;
        }
    }
    .chart-badge {
        animation: badge-pop 0.6s var(--ease) calc(var(--start) + 1100ms) backwards;
    }
    @keyframes badge-pop {
        from {
            opacity: 0;
            transform: translateY(1.5cqi) scale(0.9);
        }
    }
    .flow-steps > li {
        animation: step-in 0.6s var(--ease) calc(var(--start) + 3 * var(--stagger) + 300ms + var(--s) * 160ms) backwards;
    }
    @keyframes step-in {
        from {
            opacity: 0;
            transform: translateY(1.2cqi);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-rise,
        .w-in,
        .piece,
        .chart-line,
        .chart-badge,
        .flow-steps > li {
            animation: none;
        }
        a.piece {
            transition: none;
        }
    }

