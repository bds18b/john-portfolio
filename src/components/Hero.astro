        height: 1.5cqi;
        border: 1px solid rgb(21 21 21 / 0.22);
        border-radius: 50%;
    }
    .flow-steps {
        position: relative;
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 2cqi;
        font-size: 2.6cqi;
        line-height: 1.3;
    }
    .flow-steps::before {
        content: "";
