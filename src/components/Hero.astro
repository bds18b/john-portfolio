    /* Flow: a builder window with a post-purchase flow. A line runs down
       behind the steps, showing between them. */
    .flow {
        --x: 25cqi;
        --y: 47cqi;
        --w: 51cqi;
        --z: 3;
        padding: 0 2.6cqi 2.6cqi;
    }
    .flow-bar {
