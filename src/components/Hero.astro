        font-size: 2.4cqi;
        line-height: 1.3;
        color: #6b6b6b;
        white-space: nowrap;
    }
    .chart-head b {
        font-weight: 600;
        color: #151515;
    }
    /* Highland's deer, in its own slate, just before the name. */
    .chart-head :global(.chart-logo) {
        display: inline-block;
        width: auto;
        height: 1.45em;
        margin-right: 0.4em;
        vertical-align: middle;
        position: relative;
        top: -0.08em;
