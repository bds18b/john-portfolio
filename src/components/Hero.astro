---
import { Image } from "astro:assets";

import fealsLogo from "../assets/Feals-logo.svg";
import highlandLogo from "../assets/Highland-logo.svg";
import survivalFrogLogo from "../assets/SurvivalFrog-logo.webp";
---

<section
    class="hero-section bg-[#efefed] pt-40 pb-20 flex flex-col items-center justify-center relative overflow-x-hidden w-full"
>
    <!-- Subtle grain texture overlay -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <div
        class="w-full max-w-[900px] mx-auto px-6 flex flex-col items-center justify-center text-center gap-8 animate-fade-up"
    >
        <!-- Eyebrow badge -->
        <div
            class="flex items-center gap-2 bg-white/60 border border-[#1a1a18]/10 rounded-full px-4 py-1.5"
        >
            <span class="live-dot" aria-hidden="true"></span>
            <span
                class="font-inconsolata text-[11px] font-bold tracking-[0.18em] uppercase text-[#6b6b65]"
            >
                Available for new engagements
            </span>
        </div>

        <!-- Headline -->
        <div class="w-full">
            <h1
                class="font-oswald font-normal uppercase text-[clamp(2.4rem,5vw,4rem)] leading-[1.0] tracking-[-0.01em] text-[#1a1a18]"
            >
                Build the
                <span
                    class="pill-accent px-3 py-0.5 bg-[#1a1a18] text-white inline-block rounded"
                >
                    retention
                </span>
                <span class="block mt-1">program behind</span>
                <span class="text-accent block mt-1 tracking-tight"
                    >profitable growth.</span
                >
            </h1>
        </div>

        <!-- Subheadline — tighter, more punchy -->
        <p
            class="font-oswald text-[clamp(1rem,1.4vw,1.15rem)] uppercase tracking-wide text-[#1a1a18] leading-snug max-w-[580px]"
        >
            Retention isn't just email and SMS. It's the entire customer
            journey, from the first ad to the post-purchase experience.
        </p>

        <!-- Body copy — kept tight -->
        <p
            class="font-inconsolata text-[clamp(0.875rem,1.15vw,0.925rem)] font-normal leading-[1.65] text-[#6b6b65] max-w-[560px]"
        >
            I embed completely as your go-to customer lifecycle operator,
            building the retention engine end-to-end, turning every funnel stage
            into compounding contribution margin that supports profitable scale.
        </p>

        <!-- CTA Button Only -->
        <div class="w-full max-w-[420px]">
            <a
                href="#contact"
                class="cta-btn inline-flex items-center justify-between w-full bg-accent border-2 border-accent font-inconsolata text-[0.875rem] font-bold tracking-[0.15em] uppercase text-white no-underline px-6 py-4 rounded-xl transition-all duration-200 ease-in-out hover:bg-[#1a1a18] hover:border-[#1a1a18] group"
            >
                <span>Work with me</span>
                <span
                    class="transform transition-transform duration-200 group-hover:translate-x-1"
                    aria-hidden="true">→</span
                >
            </a>
        </div>
    </div>

    <!-- Full Width Trusted By & Marquee Container -->
    <div class="relative left-1/2 -translate-x-1/2 w-[100vw] mt-16 overflow-hidden">
        
        <!-- Trusted by Row -->
        <div class="w-full max-w-[720px] mx-auto px-6 flex items-center justify-center gap-4 mb-6">
            <div class="flex-grow border-t border-[#1a1a18]/10"></div>
            <span class="font-inconsolata text-[11px] font-bold tracking-[0.2em] uppercase text-[#9c9c96] whitespace-nowrap">
                Trusted By
            </span>
            <div class="flex-grow border-t border-[#1a1a18]/10"></div>
        </div>

        <!-- Edge-to-edge Marquee Container -->
        <div aria-hidden="true" class="w-full relative flex items-center h-20">
            <div class="inline-flex items-center animate-marquee whitespace-nowrap">
                {
                    [0, 1, 2, 3, 4, 5].map(() => (
                        <>
                            <!-- Feals: Shifted left by 5px using transform -->
                            <div class="w-[110px] md:w-[140px] flex items-center justify-center flex-shrink-0 mx-1 transform -translate-x-[5px]">
                                <Image
                                    src={fealsLogo}
                                    alt="Feals"
                                    loading="eager"
                                    class="h-5 md:h-6.5 w-auto object-contain grayscale opacity-50"
                                />
                            </div>
                            
                            <!-- Highland: Unchanged baseline anchor -->
                            <div class="w-[115px] md:w-[145px] flex items-center justify-center gap-1.5 flex-shrink-0 mx-1">
                                <Image
                                    src={highlandLogo}
                                    alt=""
                                    loading="eager"
                                    class="h-6 md:h-8 w-auto object-contain grayscale opacity-50"
                                />
                                <span class="font-oswald text-[14px] md:text-[17px] font-normal tracking-[0.05em] uppercase text-[#1a1a18]/50 leading-none">
                                    HIGHLAND
                                </span>
                            </div>
                            
                            <!-- Survival Frog: Shifted left by an additional 5px using transform -->
                            <div class="w-[195px] md:w-[235px] flex items-center justify-center gap-0.5 flex-shrink-0 mx-1 transform -translate-x-[5px]">
                                <Image
                                    src={survivalFrogLogo}
                                    alt=""
                                    loading="eager"
                                    class="h-7.5 md:h-9 w-auto object-contain grayscale opacity-50"
                                />
                                <span class="font-oswald text-[14px] md:text-[17px] font-normal tracking-[0.05em] uppercase text-[#1a1a18]/50 -ml-4 leading-none">
                                    SURVIVAL FROG
                                </span>
                            </div>
                        </>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .font-inconsolata {
        font-family: "Inconsolata", "Courier New", monospace;
    }
    .font-oswald {
        font-family: "Oswald", sans-serif;
    }

   
    .live-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--color-accent, #3b52f6);
        box-shadow: 0 0 0 0 rgba(59, 82, 246, 0.4);
        animation: pulse-dot 2s ease-in-out infinite;
    }

    @keyframes pulse-dot {
        0%,
        100% {
            box-shadow: 0 0 0 0 rgba(59, 82, 246, 0.4);
        }
        50% {
            box-shadow: 0 0 0 5px rgba(59, 82, 246, 0);
        }
    }

    /* Animations */
    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes marquee {
        0% {
            transform: translate3d(0, 0, 0);
        }
        100% {
            transform: translate3d(-16.6666%, 0, 0);
        }
    }

    .animate-fade-up {
        animation: fadeUp 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    
    .animate-marquee {
        animation: marquee 15s linear infinite;
    }

    @media (prefers-reduced-motion: reduce) {
        .animate-fade-up {
            animation: none;
        }
        .animate-marquee {
            animation-play-state: paused;
        }
        .live-dot {
            animation: none;
        }
    }
</style>