---
import { Image } from "astro:assets";

import fealsLogo from "../assets/Feals-logo.svg";
import highlandLogo from "../assets/Highland-logo.svg";
import survivalFrogLogo from "../assets/SurvivalFrog-logo.webp";
import fealsPhoto from "../assets/Feals-lifestyle-photo.jpg";
import frogPhoto from "../assets/survival-frog-lifestyle-image.webp";
import avatar from "../assets/john-avatar.jpg";

// The headline, word by word: each word rises into place in turn. The last
// two are in the accent colour.
const headline = "Turn retention into profitable growth.".split(" ");
const ACCENT_FROM = headline.indexOf("profitable");

// Phones and tablets: the client logos drift left under the buttons in an
// endless loop. The list holds the three brands four times over (enough to
// cover a tablet-wide screen) and moves left by one set at a time; only the
// first set is read out.
const LOGO_SETS = 4;

// The collage next to (or under) the copy: the tools of a retention
// program floating on a dot grid, carrying John's three headline results.
// Feals and Survival Frog are photo cards; Highland's result is the badge
// on the repeat-purchase chart. Each result links to (and opens) its case
// study. Everything else (the flow, the channel tiles, the chart's lines)
// is illustration and hidden from screen readers.

// Entrance timing (ms): the pieces come in one after another from
// VISUAL_START, `n` being each piece's place in that order. The script
// starts each result's count-up to match.
const VISUAL_START = 750;
const PIECE_STAGGER = 110;
const countDelay = (n: number) => VISUAL_START + n * PIECE_STAGGER + 400;
const BADGE_DELAY = VISUAL_START + 1100; // after the chart's lines are drawn

// The chart's two lines, Jan to Dec, in a 300 x 110 box (y measured down).
// An illustrative shape, not real data: the blue line climbs faster than
// the pale one it is compared with.
const programLine = [100, 94, 97, 86, 89, 74, 78, 62, 66, 48, 52, 34, 26];
const compareLine = [104, 101, 103, 97, 99, 92, 94, 87, 89, 82, 84, 77, 73];
const toPoints = (ys: number[]) => ys.map((y, i) => `${i * 25},${y}`).join(" ");
---

<section id="top" class="hero" data-hero>
    <!-- Hold the entrance until the fonts are in (or 0.8s at most, see the
         script below), so the letters don't rise in a fallback font and then
         change. Runs before the hero is drawn. The timeout releases it
         anyway if the page script never runs. -->
    <script is:inline>
        document.documentElement.classList.add("hero-wait");
        setTimeout(function () { document.documentElement.classList.remove("hero-wait"); }, 1500);
    </script>
    <div class="hero-inner">
        <div class="hero-copy">
            <p class="hero-intro hero-rise" style="--d: 0ms">
                <Image src={avatar} alt="" width={64} loading="eager" class="intro-avatar" />
                <span><b>John Narducci</b> · Fractional retention lead</span>
            </p>

            <h1 class="hero-title">
                {
                    headline.map((word, i) => (
                        <Fragment>
                            <span class="w">
                                <span class:list={["w-in", { "w-accent accent-texture": i >= ACCENT_FROM }]} style={`--i: ${i}`}>
                                    {word}
                                </span>
                            </span>{" "}
                        </Fragment>
                    ))
                }
            </h1>

            <p class="hero-lede hero-rise" style="--d: 450ms">
                Not just email and SMS. The entire customer journey, from the first
                ad to the post-purchase experience.
            </p>

            <div class="hero-actions hero-rise" style="--d: 550ms">
                <a href="#contact" class="btn-cta">Work with me</a>
                <a href="#case-studies" class="btn-link">
                    Case studies
                    <svg class="btn-link-arrow" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" />
                    </svg>
                </a>
            </div>

            <div class="hero-logos hero-rise" style="--d: 650ms">
                <div class="logos-window">
                    <ul class="logos-track" role="list" aria-label="Clients">
                        {
                            Array.from({ length: LOGO_SETS }, (_, set) => (
                                <Fragment>
                                    <li class="logo-item" aria-hidden={set > 0 ? "true" : undefined}>
                                        <Image src={fealsLogo} alt={set === 0 ? "Feals" : ""} width={140} class="logo-img logo-feals" />
                                    </li>
                                    <li class="logo-item" aria-hidden={set > 0 ? "true" : undefined}>
                                        <Image src={highlandLogo} alt="" width={60} class="logo-img logo-highland" />
                                        <span>Highland</span>
                                    </li>
                                    <li class="logo-item" aria-hidden={set > 0 ? "true" : undefined}>
                                        <Image src={survivalFrogLogo} alt="" width={120} class="logo-img logo-frog" />
                                        <span>Survival Frog</span>
                                    </li>
                                </Fragment>
                            ))
                        }
                    </ul>
                </div>
                <p class="logos-caption"><span>Trusted by</span> businesses like these</p>
            </div>
        </div>

        <div class="hero-visual">
            <div class="collage" style={`--start: ${VISUAL_START}ms; --stagger: ${PIECE_STAGGER}ms`}>
                <!-- Feals: photo card. -->
                <a class="piece photo photo-feals" href="#case-feals" style="--n: 1">
                    <span class="photo-frame">
                        <Image
                            src={fealsPhoto}
                            alt=""
                            widths={[240, 360, 480, 640]}
                            sizes="(min-width: 1024px) 240px, 40vw"
                            loading="eager"
                            class="photo-img"
                        />
                        <span class="photo-shade" aria-hidden="true"></span>
                        <Image src={fealsLogo} alt="" width={160} loading="eager" class="photo-logo logo-feals" />
                        <span class="photo-stat">
                            <span class="sr-only">Feals case study: +222% MRR growth</span>
                            <span class="stat-number" aria-hidden="true" data-count data-delay={countDelay(1)}>+222%</span>
                            <span class="stat-label" aria-hidden="true">MRR growth</span>
                        </span>
                    </span>
                </a>

                <!-- Highland: the repeat-purchase chart and its badge. -->
                <a class="piece chart" href="#case-highland" style="--n: 0">
                    <span class="sr-only">Highland case study: +58% repeat orders</span>
                    <span class="chart-head" aria-hidden="true"
                        ><Image src={highlandLogo} alt="" width={48} loading="eager" class="chart-logo" /><b>Highland</b> · Repeat purchase rate</span
                    >
                    <svg class="chart-svg" viewBox="0 0 300 110" aria-hidden="true">
                        <line class="chart-grid" x1="0" x2="300" y1="20" y2="20" />
                        <line class="chart-grid" x1="0" x2="300" y1="55" y2="55" />
                        <line class="chart-grid" x1="0" x2="300" y1="90" y2="90" />
                        <polyline class="chart-line chart-line-compare" pathLength="1" points={toPoints(compareLine)} />
                        <polyline class="chart-line chart-line-program" pathLength="1" points={toPoints(programLine)} />
                    </svg>
                    <span class="chart-axis" aria-hidden="true">
                        <span>Jan</span><span>Apr</span><span>Jul</span><span>Oct</span>
                    </span>
                    <span class="chart-badge" aria-hidden="true"
                        ><span class="badge-number" data-count data-delay={BADGE_DELAY + 100}>+58%</span> repeat orders</span
                    >
                </a>

                <!-- Channel tiles: email, SMS, the order. -->
                <span class="piece tile tile-mail" style="--n: 2" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                </span>

                <!-- A post-purchase flow: first order, a check-in email, then
                     either a reorder or an SMS nudge. -->
                <div class="piece flow" style="--n: 3" aria-hidden="true">
                    <span class="flow-bar"><i></i><i></i><i></i></span>
                    <ol class="flow-steps">
                        <li class="node node-trigger" style="--s: 0"><b>Trigger</b> Placed first order</li>
                        <li class="node node-wait" style="--s: 1">Wait 14 days</li>
                        <li class="node" style="--s: 2"><b>Email</b> How's it going?</li>
                        <li class="flow-split" style="--s: 3">
                            <span class="node node-done"
                                ><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>Reordered</span
                            >
                            <span class="node"><b>SMS</b> nudge</span>
                        </li>
                    </ol>
                </div>

                <span class="piece tile tile-chat" style="--n: 4" aria-hidden="true">
                    <svg viewBox="0 0 24 24"
                        ><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /><path d="M8 9h8M8 13h5" /></svg
                    >
                </span>

                <!-- Survival Frog: photo card. -->
                <a class="piece photo photo-frog" href="#case-survival-frog" style="--n: 5">
                    <span class="photo-frame">
                        <Image
                            src={frogPhoto}
                            alt=""
                            widths={[240, 360, 480, 640]}
                            sizes="(min-width: 1024px) 210px, 36vw"
                            loading="eager"
                            class="photo-img"
                        />
                        <span class="photo-shade" aria-hidden="true"></span>
                        <Image src={survivalFrogLogo} alt="" width={160} loading="eager" class="photo-logo logo-frog" />
                        <span class="photo-stat">
                            <span class="sr-only">Survival Frog case study: +42% LTV growth</span>
                            <span class="stat-number" aria-hidden="true" data-count data-delay={countDelay(5)}>+42%</span>
                            <span class="stat-label" aria-hidden="true">LTV growth</span>
                        </span>
                    </span>
                </a>

                <span class="piece tile tile-bag" style="--n: 6" aria-hidden="true">
                    <svg viewBox="0 0 24 24"
                        ><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><path d="M3 6h18" /><path d="M16 10a4 4 0 0 1-8 0" /></svg
                    >
                </span>
            </div>
        </div>
    </div>
</section>

<script>
    // Starts the entrance once the fonts are in (0.8s at most) and counts the
    // result numbers up in step with their pieces of the collage. With
    // reduced motion the numbers simply show.
    const root = document.documentElement;
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // "+222%" counts from "+0%", easing out over 1.5s after `delay` ms.
    const countUp = (el: HTMLElement, delay: number) => {
        const match = (el.textContent ?? "").trim().match(/^(\D*)(\d+)(\D*)$/);
        if (!match) return;
        const [, before, digits, after] = match;
        const target = Number(digits);
        const start = performance.now() + delay;
        const duration = 1500;
        el.textContent = `${before}0${after}`;
        const tick = (now: number) => {
            const t = Math.min(1, Math.max(0, (now - start) / duration));
            const eased = 1 - Math.pow(1 - t, 4);
            el.textContent = `${before}${Math.round(target * eased)}${after}`;
            if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
    };

    // Numbers the headline's lines (--l on each word), so each line's
    // words rise together, 80ms after the line above.
    const markLines = () => {
        const tops: number[] = [];
        hero?.querySelectorAll<HTMLElement>(".hero-title .w").forEach((word) => {
            const top = word.getBoundingClientRect().top;
            let line = tops.findIndex((t) => Math.abs(t - top) < 6);
            if (line < 0) line = tops.push(top) - 1;
            (word.firstElementChild as HTMLElement | null)?.style.setProperty("--l", String(line));
        });
    };

    const begin = () => {
        if (!root.classList.contains("hero-wait")) return;
        markLines();
        if (!reduce) {
            hero?.querySelectorAll<HTMLElement>("[data-count]").forEach((number) => {
                countUp(number, Number(number.dataset.delay ?? 0));
            });
        }
        root.classList.remove("hero-wait");
    };
    Promise.race([
        document.fonts ? document.fonts.ready : Promise.resolve(),
        new Promise((resolve) => setTimeout(resolve, 800)),
    ]).then(begin);
</script>

<style>
    /* Sizes and gaps are taken from the 1440px-wide design and scale down
       with the screen; small text stops shrinking at a readable size. */
    /* At least one screen tall, with the content centred, so on big monitors
       the next section doesn't peek in under the content. (100vh first for
       browsers without svh, the height with the mobile toolbars showing.) */
    .hero {
        background: var(--page-bg);
        padding-block: clamp(104px, 8.6vw, 124px) clamp(40px, 4.2vw, 60px);
        min-height: calc(100vh / var(--page-zoom, 1));
        min-height: calc(100svh / var(--page-zoom, 1));
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .hero-inner {
        width: 100%;
    }

    /* ---- Layout ----------------------------------------------------------
       Phones and tablets: the copy, then the collage under it; on tablets
       both are a centred column. From 1024px: side by side, the copy on the
       left and the collage on the right. The copy is left-aligned
       throughout. */
    .hero-inner {
        max-width: 1440px;
        margin-inline: auto;
        padding-inline: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .hero-copy {
        width: 100%;
        max-width: 600px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
    }
    .hero-visual {
        width: 100%;
        max-width: 560px;
        margin-top: 48px;
    }
    @media (min-width: 640px) {
        .hero-inner {
            padding-inline: 24px;
        }
    }
    @media (min-width: 1024px) {
        .hero-inner {
            padding-inline: 48px;
            display: grid;
            grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
            align-items: center;
            column-gap: clamp(32px, 4vw, 72px);
        }
        .hero-copy {
            max-width: none;
        }
        .hero-visual {
            justify-self: end;
            max-width: 600px;
            margin-top: 0;
        }
    }

    /* Who: John's photo, name and role in a small pill. */
    .hero-intro {
        margin: 0;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 4px 14px 4px 4px;
        background: #fff;
        border: 1px solid rgb(21 21 21 / 0.08);
        border-radius: 999px;
        box-shadow: 0 1px 2px rgb(21 21 21 / 0.05);
        font: 400 0.875rem/1.3 "Inter", sans-serif;
        color: #555;
    }
    .hero-intro b {
        font-weight: 600;
        color: #151515;
    }
    .hero-intro :global(.intro-avatar) {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        object-fit: cover;
    }

    /* Headline: Inter Tight SemiBold, set tight. Each word sits in a box
       that clips it, so it can rise into place from below its own line; the
       box reaches a little past the word on the right (the tight spacing
       pulls the last letter over the edge) and below it (descenders). */
    .hero-title {
        margin: 22px 0 0;
        max-width: 13em;
        font-family: "Inter Tight", "Inter", sans-serif;
        font-size: clamp(2.25rem, 10.4vw, 3.25rem);
        font-weight: 600;
        line-height: 1.06;
        letter-spacing: -0.035em;
        color: #151515;
        text-wrap: balance;
    }
    @media (min-width: 1024px) {
        .hero-title {
            margin-top: 28px;
            font-size: clamp(3.25rem, 4.6vw, 4.5rem);
        }
    }
    .w {
        display: inline-block;
        overflow: clip;
        vertical-align: top;
        padding: 0 0.06em 0.14em 0;
        margin: 0 -0.06em -0.14em 0;
    }
    .w-in {
        display: inline-block;
    }
    /* "profitable growth." in Unbounded Bold, the site's display face; it
       runs wide, so it is tracked less tightly than the rest. */
    .w-accent {
        color: var(--color-accent);
        font-family: "Unbounded", sans-serif;
        font-weight: 700;
        letter-spacing: -0.02em;
    }
    .hero-lede {
        margin: 20px 0 0;
        max-width: 30rem;
        font: 400 1.0625rem/1.55 "Inter", sans-serif;
        color: #555;
        text-wrap: pretty;
    }
    @media (min-width: 1024px) {
        .hero-lede {
            margin-top: 24px;
            font-size: 1.125rem;
        }
    }
    /* Phones: a little more room between the pieces of the copy and above
       the collage. (The gaps above the buttons and the logo strip are with
       their own phone styles below.) */
    @media (max-width: 639px) {
        .hero-title {
            margin-top: 28px;
        }
        .hero-lede {
            margin-top: 24px;
        }
        .hero-visual {
            margin-top: 56px;
        }
    }

    .hero-actions {
        margin-top: 32px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 26px;
    }
    /* "Work with me" uses the shared .btn-cta style (global.css). */
    .btn-link {
        padding-block: 15px;
        font: 500 1rem/1.5 "Inter", sans-serif;
        color: #151515;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
        transition: color 0.2s ease;
    }
    .btn-link:hover {
        color: var(--color-accent);
    }
    .btn-link:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
    }
    /* The arrow shows on phones only (where the link is a button). */
    .btn-link-arrow {
        display: none;
    }

    /* Phones: two compact buttons sharing the row in equal halves, so it
       starts and ends flush with the text above: "Work with me" in the
       blue, "Case studies" a soft grey pill with a down arrow that nudges
       down on hover. The collage runs to the screen edges. */
    @media (max-width: 639px) {
        .hero-actions {
            margin-top: 34px;
            width: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .hero-actions .btn-cta {
            justify-content: center;
            height: 46px;
            padding-inline: 16px;
            font-size: 0.9375rem;
        }
        .btn-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            height: 46px;
            padding: 0 16px;
            border-radius: 999px;
            background: #f2f2f0;
            box-shadow:
                inset 0 1px 0 #fff,
                0 0 0 1px rgb(21 21 21 / 0.1),
                0 1px 2px rgb(0 0 0 / 0.06);
            font-size: 0.9375rem;
            font-weight: 600;
            line-height: 1;
            text-decoration: none;
            transition:
                background-color 0.2s ease,
                color 0.2s ease;
        }
        .btn-link:hover {
            background: #e9e9e6;
            color: #151515;
        }
        .btn-link-arrow {
            display: block;
            width: 15px;
            height: 15px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .btn-link:hover .btn-link-arrow {
            transform: translateY(2px);
        }
        .hero-visual {
            width: calc(100% + 32px);
            max-width: none;
            margin: 36px -16px 0;
        }
    }

    /* ---- Client logos ----------------------------------------------------
       Under the buttons: the logos drift left in an endless loop, fading
       out at both edges, with the caption under them. Every logo is solid
       ink, and the whole row is softened to a grey together. The list moves
       left by a quarter of its width (one set of three, each followed by
       the same margin), which puts the second set exactly where the first
       started, so the loop has no seam. On phones the row runs to the
       screen edges. From 1024px (in the left column, under the copy) it is
       one row: the caption on the left as a small two-line label, a thin
       rule, then the drifting logos, so the column's left edge stays
       straight and only the strip itself fades. */
    .hero-logos {
        width: 100%;
        margin-top: 36px;
    }
    @media (min-width: 1024px) {
        .hero-logos {
            display: flex;
            align-items: center;
            gap: 28px;
            max-width: 36rem;
            margin-top: 44px;
        }
        .logos-window {
            flex: 1;
            min-width: 0;
        }
        .hero-logos .logos-caption {
            order: -1;
            flex: none;
            margin: 0;
            padding-right: 28px;
            border-right: 1px solid rgb(21 21 21 / 0.12);
            text-align: left;
            font-size: 0.8125rem;
            line-height: 1.35;
        }
        .hero-logos .logos-caption span {
            display: block;
        }
    }
    @media (max-width: 639px) {
        .hero-logos {
            margin-top: 44px;
            width: calc(100% + 32px);
            margin-inline: -16px;
        }
    }
    .logos-window {
        overflow: hidden;
        -webkit-mask-image: linear-gradient(to right, transparent, #000 14%, #000 86%, transparent);
        mask-image: linear-gradient(to right, transparent, #000 14%, #000 86%, transparent);
    }
    .logos-track {
        display: flex;
        width: max-content;
        margin: 0;
        padding: 0;
        list-style: none;
        animation: logos-drift 24s linear infinite;
    }
    @keyframes logos-drift {
        to {
            transform: translateX(-25%);
        }
    }
    .logo-item {
        flex: none;
        display: flex;
        align-items: center;
        gap: 8px;
        height: 32px;
        margin-right: 68px;
        color: #151515;
        opacity: 0.55;
        font: 600 1.0625rem/1 "Inter Tight", "Inter", sans-serif;
        letter-spacing: -0.02em;
        white-space: nowrap;
    }
    .logo-item :global(.logo-img) {
        display: block;
        width: auto;
        filter: brightness(0);
    }
    .logo-item :global(.logo-feals) {
        height: 22px;
    }
    .logo-item :global(.logo-highland) {
        height: 26px;
    }
    /* The frog sits in the middle of a wide image, with empty space taking
       up 27.5% of the width on each side; the negative margins take that
       space back, so the name sits as close to the frog as Highland's to
       its deer. At this height the frog matches the deer. */
    .logo-item :global(.logo-frog) {
        height: 27px;
        margin-inline: -14px;
    }
    .logos-caption {
        margin: 22px 0 0;
        text-align: center;
        font: 400 0.875rem/1.4 "Inter", sans-serif;
        color: #6b6f76;
    }
    .logos-caption span {
        color: #9ca3af;
    }
    /* Reduced motion: one still set, centred, wrapping if it must. */
    @media (prefers-reduced-motion: reduce) {
        .logos-window {
            -webkit-mask-image: none;
            mask-image: none;
        }
        .logos-track {
            width: auto;
            flex-wrap: wrap;
            justify-content: center;
            row-gap: 12px;
            animation: none;
        }
        .logo-item {
            margin-inline: 34px;
        }
        .logo-item[aria-hidden="true"] {
            display: none;
        }
    }

    /* ---- Collage ---------------------------------------------------------
       A square canvas. Every piece is placed and sized in cqi (1% of the
       canvas width), so the whole picture scales as one at any width.
       Pieces are white cards; --x, --y and --w place them, --r tilts them
       and --z stacks them. */
    .collage {
        position: relative;
        aspect-ratio: 1;
        container-type: inline-size;
        isolation: isolate;
        color: #151515;
        font-family: "Inter", sans-serif;
        text-align: left;
    }
    /* Dot grid, fading out towards the edges. */
    .collage::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: radial-gradient(circle, rgb(21 21 21 / 0.2) 1px, transparent 1.5px) 0 0 / 18px 18px;
        -webkit-mask-image: radial-gradient(ellipse at center, #000 45%, transparent 72%);
        mask-image: radial-gradient(ellipse at center, #000 45%, transparent 72%);
    }

    .piece {
        position: absolute;
        left: var(--x);
        top: var(--y);
        width: var(--w);
        z-index: var(--z, 1);
        rotate: var(--r, 0deg);
        background: #fff;
        border: 1px solid rgb(21 21 21 / 0.08);
        border-radius: 2.2cqi;
        box-shadow:
            0 1px 2px rgb(21 21 21 / 0.04),
            0 1.2cqi 3cqi -1.4cqi rgb(21 21 21 / 0.1);
    }
    /* The results are links to their case studies. */
    a.piece {
        display: block;
        color: inherit;
        text-decoration: none;
        transition:
            scale 0.4s var(--ease),
            box-shadow 0.4s var(--ease);
    }
    a.piece:hover {
        scale: 1.03;
        box-shadow:
            0 1px 2px rgb(21 21 21 / 0.04),
            0 2cqi 4.4cqi -1.6cqi rgb(21 21 21 / 0.14);
    }
    a.piece:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
    }

    /* Chart (Highland). */
    .chart {
        --x: 3cqi;
        --y: 10cqi;
        --w: 57cqi;
        padding: 2.8cqi 3cqi 2.4cqi;
    }
    .chart-head {
