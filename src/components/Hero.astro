        border-radius: 50%;
        background: var(--accent-fill);
        image-rendering: pixelated;
    }
    .node-wait {
        border-style: dashed;
        background: #fafafa;
        color: #6b6b6b;
    }
    .flow-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.6cqi;
    }
    .node-done {
        display: flex;
        align-items: center;
        gap: 0.8cqi;
