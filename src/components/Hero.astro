    .chart-badge {
        position: absolute;
        left: 30%;
        top: 46%;
        padding: 0.9cqi 1.6cqi;
        border-radius: 1.2cqi;
        background: #151515;
        color: #fff;
        font-size: 2.4cqi;
        font-weight: 600;
        line-height: 1.3;
        white-space: nowrap;
        box-shadow: 0 0.8cqi 1.6cqi -0.8cqi rgb(21 21 21 / 0.18);
    }
    .badge-number {
        font-variant-numeric: tabular-nums;
    }

    /* Photo cards (Feals, Survival Frog): the photo in a white frame, the
       brand's logo in the top corner and the result at the bottom. */
    .photo {
        padding: 1.2cqi;
    }
    .photo-feals {
        --x: 59cqi;
        --y: 3cqi;
        --w: 38cqi;
        --r: 3deg;
        --z: 2;
    }
    .photo-frog {
        --x: 3cqi;
        --y: 68cqi;
        --w: 34cqi;
        --r: -3deg;
        --z: 2;
    }
    .photo-frame {
        position: relative;
        display: block;
        overflow: hidden;
        aspect-ratio: 16 / 10;
        border-radius: 1.4cqi;
        background: #2b2723;
    }
    .photo :global(.photo-img) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .photo-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgb(0 0 0 / 0.25), rgb(0 0 0 / 0.1) 35%, rgb(0 0 0 / 0.72));
    }
    .photo :global(.photo-logo) {
        position: absolute;
        top: 2cqi;
        left: 2.2cqi;
        height: auto;
        filter: brightness(0) invert(1);
    }
    .photo :global(.logo-feals) {
        width: 26%;
    }
    /* The frog image has empty space around the frog, so it is set wider
       and pulled up and left by that space. */
    .photo :global(.logo-frog) {
        width: 24%;
