---
// Footer.astro
---

<footer
    class="bg-[#efefed] pb-[clamp(24px,5vw,48px)] px-[clamp(24px,5vw,48px)] w-full mx-auto"
>
    <div
        class="w-full bg-[#1a1a18] text-white rounded-[24px] p-8 sm:p-12 md:p-16 lg:p-20"
    >
        <div
            class="w-full grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-start"
        >
            <div class="md:col-span-5 flex flex-col gap-8">
                <div class="flex flex-col gap-3">
                    <p
                        class="font-inconsolata text-[0.95rem] font-bold tracking-[0.05em] uppercase text-white"
                    >
                        Fractional Retention Portfolio
                    </p>
                </div>

                <div class="flex flex-col gap-4 max-w-sm w-full">
                    <span
                        class="font-inconsolata text-[0.75rem] font-bold tracking-[0.15em] uppercase text-white/50"
                    >
                        Stay Updated
                    </span>
                    <form
                        class="flex items-center gap-3 w-full"
                        onsubmit="event.preventDefault();"
                    >
                        <div class="relative flex-1">
                            <input
                                type="email"
                                placeholder="Email Address"
                                class="w-full bg-white/10 text-white placeholder-white/40 font-inconsolata text-[0.9rem] tracking-wide rounded-xl px-6 py-3.5 border border-white/10 focus:outline-none focus:border-white/30 transition-all"
                                required
                            />
                        </div>
                        <button
                            type="submit"
                            aria-label="Submit Email"
                            class="flex items-center justify-center bg-[var(--color-accent,#6b6b65)] text-white w-12 h-12 rounded-xl transition-all shrink-0 group hover:opacity-90 cursor-pointer"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-5 h-5 transform transition-transform group-hover:translate-x-0.5"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                                ></path>
                            </svg>
                        </button>
                    </form>
                </div>
            </div>

            <div class="md:col-span-7 grid grid-cols-2 gap-8 font-inconsolata">
                <div class="flex flex-col gap-4">
                    <span
                        class="text-[0.75rem] font-bold tracking-[0.15em] uppercase text-white/50"
                    >
                        Navigation
                    </span>
                    <nav class="flex flex-col gap-3">
                        <a href="#" class="footer-link"> Home </a>
                        <a href="#services" class="footer-link"> Services </a>
                        <a href="#case-studies" class="footer-link">
                            Case Studies
                        </a>
                        <a href="#testimonials" class="footer-link">
                            Testimonials
                        </a>
                    </nav>
                </div>

                <div class="flex flex-col gap-4">
                    <span
                        class="text-[0.75rem] font-bold tracking-[0.15em] uppercase text-white/50"
                    >
                        Connect
                    </span>
                    <nav class="flex flex-col gap-3">
                        <a href="#contact" class="footer-link"> Let's Talk </a>
                        <a
                            href="https://linkedin.com"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="footer-link"
                        >
                            LinkedIn
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</footer>

<style>
    .font-inconsolata {
        font-family: "Inconsolata", "Courier New", monospace;
    }

    .footer-link {
        font-size: 0.88rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        transition: color 0.2s ease-in-out;
    }

    .footer-link:hover {
        color: var(--color-accent, #6b6b65) !important;
    }
</style>
