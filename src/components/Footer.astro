---
// The page ends on a dark block: a closing call to action set like the
// hero (it echoes the hero's headline), then the footer links.
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="footer-block">
        <div class="footer-cta">
            <!-- Set like the hero's headline: Inter Tight, with the last
                 words in Unbounded and the accent texture. -->
            <h2 class="footer-title" data-reveal="lines">
                Let's turn retention into
                <span class="footer-accent keyword accent-texture">profitable growth.</span>
            </h2>
            <p class="footer-sub" data-reveal>
                If your plan for next year is “spend more and hope CAC holds,”
                let's talk.
            </p>
            <a href="#contact" class="btn-cta footer-btn" data-reveal>Work with me</a>
        </div>

        <div class="footer-bottom" data-reveal>
            <a href="#top" class="footer-name" aria-label="Retention First, back to top"
                ><span class="mark-first" aria-hidden="true">Retention</span><span class="mark-last" aria-hidden="true"
                    >First</span
                ></a
            >
            <nav class="footer-nav" aria-label="Footer">
                <a href="#comparison" class="footer-link">Why me</a>
                <a href="#about" class="footer-link">About</a>
                <a href="#services" class="footer-link">Approach</a>
                <a href="#case-studies" class="footer-link">Case studies</a>
                <a href="#testimonials" class="footer-link">Testimonials</a>
                <a
                    href="https://www.linkedin.com/in/john-narducci-b30540185"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer-link">LinkedIn</a
                >
            </nav>
            <p class="footer-copy">
                © {year}<span class="footer-dot" aria-hidden="true">·</span><a
                    href="https://bradenseidl.com"
                    target="_blank"
                    rel="noopener"
                    class="footer-credit">Built by Braden</a
                >
            </p>
        </div>
    </div>
</footer>

<style>
    /* Same side padding as the testimonials above (20px, then 48px from
       900px), so the blue block and this one are exactly the same width. */
    .site-footer {
        padding: 0 20px clamp(20px, 3.3vw, 48px);
        background: var(--page-bg);
    }
    /* Joined straight onto the bottom of the blue testimonials block: square
       where they meet, rounded only at the bottom, so the two make one block
       (blue on top, black below). */
    .footer-block {
        --radius: 20px;
        max-width: 1344px;
        margin-inline: auto;
        padding: clamp(64px, 9vw, 136px) clamp(24px, 5vw, 80px) clamp(28px, 3vw, 40px);
        border-radius: 0 0 var(--radius) var(--radius);
        background: #151515;
        color: #fff;
    }
    @media (min-width: 900px) {
        .site-footer {
            padding-inline: 48px;
        }
        .footer-block {
            --radius: 24px;
        }
    }

    /* Closing call to action, centred like the hero */
    .footer-cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    .footer-title {
        margin: 0;
        max-width: 13em;
        font-family: "Inter Tight", "Inter", sans-serif;
        font-weight: 600;
        font-size: clamp(2.25rem, 5.2vw, 4.5rem);
        line-height: 1.06;
        letter-spacing: -0.035em;
        text-wrap: balance;
    }
    /* "profitable growth." wears the accent texture. */
    .footer-accent {
        color: var(--color-accent);
    }
    .footer-sub {
        margin: clamp(18px, 2vw, 28px) 0 0;
        max-width: 32rem;
        font-family: "Inter", sans-serif;
        font-size: 1rem;
        line-height: 1.6;
        color: rgb(255 255 255 / 0.72);
        text-wrap: balance;
    }
    /* The hero's button, hover and all. */
    .footer-btn {
        margin-top: clamp(24px, 2.6vw, 36px);
    }

    /* Links and copyright */
    .footer-bottom {
        margin-top: clamp(64px, 8vw, 120px);
        padding-top: 28px;
        border-top: 1px solid rgb(255 255 255 / 0.12);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 20px 40px;
    }
    /* The nav's wordmark: RETENTIONFIRST in capitals, run together, the
       first word heavy and the second light. */
    .footer-name {
        display: inline-flex;
        align-items: baseline;
        font-family: "Inter Tight", "Inter", sans-serif;
        font-size: 18px;
        line-height: 1;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        white-space: nowrap;
        color: #fff;
        text-decoration: none;
    }
    .mark-first {
        font-weight: 800;
    }
    .mark-last {
        margin-left: 0.08em;
        font-weight: 300;
    }
    .footer-name:focus-visible {
        outline: 2px solid #7b84ff;
        outline-offset: 4px;
        border-radius: 2px;
    }
    .footer-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 28px;
    }
    .footer-copy {
        margin: 0 0 0 auto;
        font-family: "Inter", sans-serif;
        font-size: 0.85rem;
        color: rgb(255 255 255 / 0.5);
    }
    .footer-dot {
        margin-inline: 0.5em;
    }
    /* The site credit: as quiet as the year beside it, brighter on hover. */
    .footer-credit {
        color: inherit;
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .footer-credit:hover {
        color: #fff;
    }
    .footer-credit:focus-visible {
        outline: 2px solid #7b84ff;
        outline-offset: 3px;
        border-radius: 2px;
    }
    /* The padding (cancelled out by the negative margin) makes each link a
       comfortable size to tap without changing the spacing you see. */
    .footer-link {
        padding-block: 10px;
        margin-block: -10px;
        font-family: "Inter", sans-serif;
        font-size: 14px;
        font-weight: 500;
        color: rgb(255 255 255 / 0.72);
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .footer-link:hover {
        color: #fff;
    }
    .footer-link:focus-visible {
        outline: 2px solid #7b84ff;
        outline-offset: 3px;
    }

    @media (max-width: 767px) {
        .footer-bottom {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        .footer-nav {
            justify-content: center;
        }
        .footer-copy {
            margin: 0;
        }
    }

    /* ---- Dark ------------------------------------------------------------
       The page itself is near-black, so the block steps up a shade. */
    :global(:root[data-site-theme="dark"]) .footer-block {
        background: #19191c;
    }
</style>
