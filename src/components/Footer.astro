---
// The page ends on a dark block: a closing call to action set like the
// hero (it echoes the hero's headline), then the footer links.
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="footer-block">
        <div class="footer-cta">
            <!-- One sentence on wide screens; on phones the spans become four
                 lines shaped like the hero's headline (see the styles). -->
            <h2 class="footer-title">
                <span class="ft-line">Let's build the</span>
                <span class="ft-line ft-big">retention</span>
                <span class="ft-line">program behind</span>
                <span class="ft-line footer-accent">your growth.</span>
            </h2>
            <p class="footer-sub">
                If your plan for next year is “spend more and hope CAC holds,”
                let's talk.
            </p>
            <a href="#contact" class="btn-cta footer-btn">Work with me</a>
        </div>

        <div class="footer-bottom">
            <p class="footer-name">John Narducci</p>
            <nav class="footer-nav" aria-label="Footer">
                <a href="#comparison" class="footer-link">Why me</a>
                <a href="#about" class="footer-link">About</a>
                <a href="#services" class="footer-link">Approach</a>
                <a href="#case-studies" class="footer-link">Case studies</a>
                <a href="#testimonials" class="footer-link">Testimonials</a>
                <a
                    href="https://www.linkedin.com/in/john-narducci-b30540185"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer-link">LinkedIn</a
                >
            </nav>
            <p class="footer-copy">© {year}</p>
        </div>
    </div>
</footer>

<style>
    /* Same side padding as the testimonials above (20px, then 48px from
       900px), so the blue block and this one are exactly the same width. */
    .site-footer {
        padding: 0 20px clamp(20px, 3.3vw, 48px);
        background: #efefed;
    }
    /* Joined straight onto the bottom of the blue testimonials block: square
       where they meet, rounded only at the bottom, so the two make one block
       (blue on top, black below). */
    .footer-block {
        --radius: 20px;
        max-width: 1344px;
        margin-inline: auto;
        padding: clamp(64px, 9vw, 136px) clamp(24px, 5vw, 80px) clamp(28px, 3vw, 40px);
        border-radius: 0 0 var(--radius) var(--radius);
        background: #151515;
        color: #fff;
    }
    @media (min-width: 900px) {
        .site-footer {
            padding-inline: 48px;
        }
        .footer-block {
            --radius: 24px;
        }
    }

    /* Closing call to action, centred like the hero */
    .footer-cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    .footer-title {
        margin: 0;
        max-width: 15em;
        font-family: "Unbounded", sans-serif;
        font-weight: 900;
        font-size: clamp(1.9rem, 5.4vw, 4.9rem);
        line-height: 1.02;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        text-wrap: balance;
    }
    .footer-accent {
        color: var(--color-accent);
    }
    /* Phones: left to wrap, the sentence broke into six short, ragged lines.
       Instead it is set in four, like the hero: RETENTION big across the
       full width, the other lines smaller, with "program behind" (the
       longest) also spanning it. The sizes are fractions of the block's
       inner width (cqi), from the measured widths of the lines in Unbounded
       Black: RETENTION is 7.34em wide, PROGRAM BEHIND 11.74em. Capped so a
       large phone held sideways doesn't get giant type. */
    @media (max-width: 639px) {
        .footer-cta {
            container-type: inline-size;
        }
        .footer-title {
            max-width: none;
        }
        .ft-line {
            display: block;
            font-size: min(8.4cqi, 2.25rem);
            line-height: 1.12;
        }
        .ft-big {
            font-size: min(13.4cqi, 3.6rem);
            line-height: 1;
        }
    }
    .footer-sub {
        margin: clamp(18px, 2vw, 28px) 0 0;
        max-width: 32rem;
        font-family: "Inter", sans-serif;
        font-size: 1rem;
        line-height: 1.6;
        color: rgb(255 255 255 / 0.72);
        text-wrap: balance;
    }
    /* On the dark block the button fills white, with dark text. */
    .footer-btn {
        --btn-fill: #fff;
        --btn-text-hover: #151515;
        margin-top: clamp(24px, 2.6vw, 36px);
    }

    /* Links and copyright */
    .footer-bottom {
        margin-top: clamp(64px, 8vw, 120px);
        padding-top: 28px;
        border-top: 1px solid rgb(255 255 255 / 0.12);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 20px 40px;
    }
    .footer-name {
        margin: 0;
        font-family: "Unbounded", sans-serif;
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .footer-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 28px;
    }
    .footer-copy {
        margin: 0 0 0 auto;
        font-family: "Inter", sans-serif;
        font-size: 0.85rem;
        color: rgb(255 255 255 / 0.5);
    }
    /* The padding (cancelled out by the negative margin) makes each link a
       comfortable size to tap without changing the spacing you see. */
    .footer-link {
        padding-block: 10px;
        margin-block: -10px;
        font-family: "Unbounded", sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: rgb(255 255 255 / 0.72);
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .footer-link:hover {
        color: #fff;
    }
    .footer-link:focus-visible {
        outline: 2px solid #7b84ff;
        outline-offset: 3px;
    }

    @media (max-width: 767px) {
        .footer-bottom {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        .footer-nav {
            justify-content: center;
        }
        .footer-copy {
            margin: 0;
        }
    }
</style>
