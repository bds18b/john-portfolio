---
// Testimonials, shown one at a time in large type with previous / next
// buttons, and a swipe on touch screens (no auto-advance: the quotes are
// long, and a timer would cut readers off). Without JavaScript all of them
// are listed. The buttons come after the quote: under it on phones, and
// placed under the heading on wide screens.
const testimonials = [
  {
    name: "Amit",
    role: "Founder",
    company: "8-Figure DTC Brand",
    quote: "You aren't getting standard outsourced agency task-takers here. Having an executive-level advisor deeply embedded in our unit economics completely shifted how we approach retention and profitable scale.",
    active: true
  },
  {
    name: "Alexa",
    role: "Head of Growth",
    company: "E-commerce Ecosystem",
    quote: "Unlike every traditional email agency we've hired, there was zero bait-and-switch. Direct strategy, flawless execution, and a custom roadmap engineered specifically around our biggest conversion bottlenecks.",
    active: true // Set to false if dropping this testimonial
  },
  {
    name: "Tiffany",
    role: "Operations Director",
    company: "Apparel Brand",
    quote: "The deep understanding of financial and unit-level economics as it relates to marketing performance completely changed the math on our bottom-line retention metrics.",
    active: true // Set to false if dropping this testimonial
  },
  {
    name: "Connor",
    role: "Co-Founder",
    company: "DTC Brand",
    quote: "Working with an actual partner who owns the strategy and growth programs end-to-end—rather than a junior account manager—is the best decision we made this year.",
    active: true
  }
];

// Filter out any names you decide not to use
const visibleTestimonials = testimonials.filter(t => t.active);
const total = String(visibleTestimonials.length).padStart(2, "0");
---

<section id="testimonials" class="testimonials">
  <div class="t-inner" data-testimonials data-reveal>
    <div class="t-head">
      <h2 class="t-title" data-reveal="lines">
        Built for <span class="t-highlight keyword nowrap">8-figure scale</span>
      </h2>
      <p class="t-intro" data-reveal>
        From founders and operators I've worked with.
      </p>
    </div>

    <div class="t-stage" data-stage aria-live="polite" data-reveal>
      {visibleTestimonials.map((item) => (
        <figure class="t-quote" data-quote>
          <span class="t-mark" aria-hidden="true">“</span>
          <blockquote class="t-text">
            <p>{item.quote}</p>
          </blockquote>
          <figcaption class="t-author">
            <span class="t-name">{item.name}</span>
            <span class="t-role">{item.role}, {item.company}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="t-controls" data-controls hidden>
      <button type="button" class="t-btn" data-prev aria-label="Previous testimonial">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <span class="t-count" aria-hidden="true"><span data-current>01</span> / {total}</span>
      <button type="button" class="t-btn" data-next aria-label="Next testimonial">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>
</section>

<script>
  // Turns the list of quotes into a one-at-a-time view with previous / next
  // buttons and swiping. The hidden quotes are made inert so they can't be
  // focused or read out until they are shown. Quotes slide sideways in the
  // direction of travel: going forward, the new one comes in from the right
  // as the old one leaves to the left (data-dir sets which way).
  function setupTestimonials() {
    const root = document.querySelector<HTMLElement>("[data-testimonials]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";

    const stage = root.querySelector<HTMLElement>("[data-stage]");
    const quotes = [...root.querySelectorAll<HTMLElement>("[data-quote]")];
    const controls = root.querySelector<HTMLElement>("[data-controls]");
    const current = root.querySelector<HTMLElement>("[data-current]");
    if (!stage || !controls || quotes.length < 2) return;

    let index = -1;
    const show = (next: number, dir: "next" | "prev" = "next") => {
      const previous = index;
      index = (next + quotes.length) % quotes.length;
      stage.dataset.dir = dir;
      quotes.forEach((q, k) => {
        const on = k === index;
        q.classList.toggle("is-active", on);
        q.classList.toggle("is-leaving", k === previous && !on);
        q.inert = !on;
      });
      if (current) current.textContent = String(index + 1).padStart(2, "0");
    };
    const step = (by: 1 | -1) => show(index + by, by > 0 ? "next" : "prev");

    stage.classList.add("is-enhanced");
    controls.hidden = false;
    root.querySelector("[data-prev]")?.addEventListener("click", () => step(-1));
    root.querySelector("[data-next]")?.addEventListener("click", () => step(1));

    // Swipe: left for the next quote, right for the previous. Only a clearly
    // sideways swipe counts, so scrolling the page up or down never changes
    // the quote. Passive listeners: the page's scrolling is never held up.
    let startX = 0;
    let startY = 0;
    let tracking = false;
    stage.addEventListener(
      "touchstart",
      (e) => {
        tracking = e.touches.length === 1;
        if (!tracking) return;
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
      },
      { passive: true },
    );
    stage.addEventListener(
      "touchend",
      (e) => {
        if (!tracking) return;
        tracking = false;
        const touch = e.changedTouches[0];
        const dx = touch.clientX - startX;
        const dy = touch.clientY - startY;
        if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
        step(dx < 0 ? 1 : -1);
      },
      { passive: true },
    );

    show(0);
  }

  setupTestimonials();
  document.addEventListener("astro:after-swap", setupTestimonials);
</script>

<style>
  .testimonials {
    /* No space below: the dark closing block joins straight on (Footer.astro). */
    padding: var(--section-space) 20px 0;
    background: var(--page-bg);
  }
  /* A blue block, the same width as the case study cards above and the dark
     closing block below (1440px including the page padding), echoing the
     comparison's blue near the top of the page. Text is white; the dark
     accents (the heading's highlight, the quote mark) pick up the black of
     the closing block. */
  /* Rounded only at the top: the dark closing block joins straight on below
     (square where they meet, rounded at its bottom). */
  .t-inner {
    max-width: 1344px;
    margin-inline: auto;
    padding: clamp(40px, 6vw, 88px) clamp(24px, 5vw, 80px);
    border-radius: 20px 20px 0 0;
    background: var(--accent-fill-soft);
    image-rendering: pixelated;
    color: #fff;
    display: grid;
    gap: 40px;
  }
  .t-highlight {
    color: #151515;
  }

  /* Heading, intro and the buttons */
  .t-title {
    margin: 0;
    font-family: "Inter Tight", "Inter", sans-serif;
    font-weight: 600;
    font-size: clamp(2rem, 3.9vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: #fff;
  }
  .t-intro {
    margin: 14px 0 0;
    max-width: 30rem;
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.85);
  }
  /* Phones: under the quote (the block's 40px gap above). */
  .t-controls {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .t-controls[hidden] {
    display: none;
  }
  .t-btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.45);
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }
  .t-btn:hover {
    background: #fff;
    border-color: #fff;
    color: var(--color-accent);
  }
  .t-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .t-btn path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* A fixed width (wider than any "0X / 0X"), so the next button doesn't
     move as the digits change width. */
  .t-count {
    flex: none;
    width: 6em;
    text-align: center;
    font-variant-numeric: tabular-nums;
    font-family: "Inter", sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgb(255 255 255 / 0.85);
  }

  /* Quotes: listed one under another until the script takes over */
  .t-stage {
    display: grid;
    gap: 48px;
  }
  /* Keeps "8-figure scale" on one line (and from breaking after the
     hyphen), so on phones it sits under "Built for" as a whole. */
  .nowrap {
    white-space: nowrap;
  }

  /* --q is the quote's text size. The quote mark is 2.7 times that. In
     Unbounded the mark's ink starts at the capital height (0.25em below the
     top of its content area) and is 0.41em tall. */
  .t-quote {
    --q: clamp(1.15rem, 2vw, 1.65rem);
    --m: calc(var(--q) * 2.7);
    position: relative;
    margin: 0;
  }
  /* Narrow screens: the mark sits above the quote, its box cut to just
     below the ink so the space under it is a real gap. */
  .t-mark {
    display: block;
    height: calc(var(--m) * 0.55);
    margin: calc(var(--m) * -0.125) 0 14px;
    font-family: "Unbounded", sans-serif;
    font-weight: 900;
    font-size: var(--m);
    line-height: 1;
    color: #151515;
  }
  /* Wide screens: the mark hangs in the gutter to the left, its top level
     with the top of the first line's capitals, so the quote text starts
     level with the heading beside it. (The first line's capitals start
     0.325 of the text size down its 1.4 line; the mark's ink starts 0.125
     of its own size down its line.) */
  @media (min-width: 900px) {
    .t-mark {
      position: absolute;
      top: calc(var(--q) * 0.325 - var(--m) * 0.125);
      right: 100%;
      height: auto;
      margin: 0 calc(var(--q) * 0.6) 0 0;
    }
  }
  .t-text {
    margin: 0;
  }
  .t-text p {
    margin: 0;
    font-family: "Inter Tight", "Inter", sans-serif;
    font-weight: 600;
    font-size: calc(var(--q) * 1.12);
    line-height: 1.28;
    letter-spacing: -0.025em;
    color: #fff;
    text-wrap: pretty;
  }
  .t-author {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .t-name {
    font-family: "Inter", sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }
  .t-role {
    font-family: "Inter", sans-serif;
    font-size: 0.9rem;
    color: rgb(255 255 255 / 0.78);
  }

  /* One at a time: every quote sits in the same grid cell, so the box is as
     tall as the longest quote and nothing jumps when they change. */
  .t-stage.is-enhanced {
    gap: 0;
  }
  /* Hidden quotes wait off to one side (--dir: 1 to the right when going
     forward, -1 to the left going back), so the new one slides in from that
     side while the old one (.is-leaving) slides out the other. */
  .t-stage.is-enhanced {
    --dir: 1;
  }
  .t-stage.is-enhanced[data-dir="prev"] {
    --dir: -1;
  }
  .t-stage.is-enhanced .t-quote {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateX(calc(var(--dir) * 32px));
    transition:
      opacity 0.4s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.4s;
  }
  .t-stage.is-enhanced .t-quote.is-leaving {
    transform: translateX(calc(var(--dir) * -32px));
  }
  .t-stage.is-enhanced .t-quote.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0.08s, 0.08s, 0s;
  }

  /* Wide screens: two equal halves, like the comparison and About: heading
     and buttons on the left, the quote on the right. The buttons come last
     in the page, so they're placed: the second row on the left, which takes
     whatever height the quote needs beyond the heading (1fr), so they sit
     right under the heading. */
  @media (min-width: 900px) {
    .testimonials {
      padding-inline: 48px;
    }
    .t-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      gap: 0 clamp(48px, 6vw, 96px);
      align-items: start;
      border-radius: 24px 24px 0 0;
    }
    .t-head {
      grid-area: 1 / 1;
    }
    .t-stage {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .t-controls {
      grid-area: 2 / 1;
      margin-top: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .t-stage.is-enhanced .t-quote {
      transition: none;
    }
  }
</style>
