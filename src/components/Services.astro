---
const steps = [
    {
        phase: "Phase One",
        title: "Diagnose",
        description:
            "Deep dive into high level business data, customer behavior, and lifecycle channels to identify key areas of opportunity.",
        badges: ["Business Data", "Customer Behavior", "Lifecycle Channels"],
    },
    {
        phase: "Phase Two",
        title: "Align + Build",
        description:
            "Build the end-to-end retention strategy across the entire customer lifecycle prioritized by contribution margin impact and aligned to your growth goals.",
        badges: ["Retention Strategy", "Contribution Margin", "Growth Goals"],
    },
    {
        phase: "Phase Three",
        title: "Deploy",
        description:
            "Embed as your go to retention and customer lifecycle strategic advisor. Lead execution on highest priority initiatives across your team. Owning the strategy, the systems, and the outcomes.",
        badges: ["Systems Ownership", "Execution", "Strategic Advisor"],
    },
    {
        phase: "Phase Four",
        title: "Analyze + Scale",
        description:
            "Every lever gets measured against the outcomes that matter most. Contribution margin, LTV, time to reorder, and MRR. The result: a compounding retention engine that fuels acquisition and supports profitable growth.",
        badges: ["LTV", "MRR", "Time to Reorder", "Profitable Growth"],
    },
];
---

<section
    id="services"
    class="relative w-full bg-[#efefed] px-5 py-24 sm:px-10 md:px-16 md:py-32 lg:px-24 overflow-hidden"
>
    <div class="mx-auto max-w-3xl relative">
        <!-- Giant Ambient Background Counter -->
        <div
            id="timeline-counter"
            class="hidden md:block absolute right-0 top-0 font-oswald text-[12rem] font-bold text-[#1a1a18]/5 select-none pointer-events-none transition-all duration-500 ease-out translate-y-[-20px]"
            aria-hidden="true"
        >
            01
        </div>

        <!-- Section header -->
        <div class="mb-12 md:mb-20 relative z-10">
            <span
                class="mb-4 block font-mono text-xs uppercase tracking-[0.3em] text-accent"
            >
                <span class="text-[#6b6b65]">Approach</span>
            </span>
            <h2
                class="mb-4 font-oswald text-[clamp(1.75rem,4vw,3rem)] font-normal uppercase leading-[1.1] tracking-tight text-[#1a1a18]"
            >
                The Full Funnel Approach <span class="text-accent"
                    >to Retention</span
                >
            </h2>
            <p
                class="max-w-xl font-inconsolata text-sm leading-relaxed text-[#6b6b65] md:text-base"
            >
                I don't chase vanity metrics. I root my decision making process
                in the data and customer behavior insights specific to your
                business to identify levers that impact the bottom line.
                Operating as an extension of your team, focused on the outcomes
                that support long term growth.
            </p>
        </div>

        <!-- Steps Timeline Track Wrap -->
        <div class="relative z-10">
            <!-- Background timeline track - Exact center math alignment -->
            <div
                class="absolute left-[1.0625rem] top-0 h-full w-px bg-[#1a1a18]/10"
                aria-hidden="true"
            >
            </div>

            <!-- Accent fill timeline — GPU-accelerated scaleY perfectly straight and centered -->
            <div
                id="timeline-fill"
                class="absolute left-[1.0625rem] top-0 h-full w-px origin-top bg-accent will-change-transform"
                aria-hidden="true"
                style="transform: scaleY(0)"
            >
            </div>

            <div class="flex flex-col gap-12 md:gap-16">
                {
                    steps.map((step, i) => (
                        <div
                            class="services-step group relative flex gap-5 md:gap-10"
                            data-step-index={i}
                        >
                            {/* Step number bubble */}
                            <div
                                class="services-bubble relative z-10 flex size-9 shrink-0 items-center justify-center rounded-full border border-[#1a1a18]/10 bg-[#efefed] font-mono text-xs text-[#6b6b65]"
                                data-step-bubble
                            >
                                {String(i + 1).padStart(2, "0")}
                            </div>

                            {/* Step content */}
                            <div class="services-content min-w-0 flex-grow pb-2">
                                <span class="block font-mono text-[10px] font-bold uppercase tracking-wider text-accent/80 mb-1">
                                    {step.phase}
                                </span>
                                <h3 class="services-title mb-3 font-oswald text-base font-normal uppercase tracking-wide text-[#1a1a18] md:text-lg lg:text-xl">
                                    {step.title}
                                </h3>
                                <p class="font-inconsolata text-sm leading-relaxed text-[#6b6b65] md:text-base mb-4">
                                    {step.description}
                                </p>

                                {/* Technical Data Badges */}
                                <div class="flex flex-wrap gap-1.5 opacity-60 group-transparent transition-opacity duration-300 services-badge-wrap">
                                    {step.badges.map((badge) => (
                                        <span class="inline-block px-2 py-0.5 rounded border border-[#1a1a18]/10 bg-[#1a1a18]/5 font-mono text-[10px] tracking-wide text-[#1a1a18]/80 uppercase">
                                            {badge}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>

    <script>
        const initServicesTimeline = () => {
            const timelineFill = document.getElementById("timeline-fill");
            const timelineCounter = document.getElementById("timeline-counter");
            const stepsContainer = document.querySelector(
                "#services .relative",
            ) as HTMLElement;
            const stepEls = document.querySelectorAll(".services-step");
            const bubbles = document.querySelectorAll("[data-step-bubble]");

            if (!timelineFill || !stepsContainer || stepEls.length === 0)
                return;

            // Scroll-triggered initial layout fade-up animation setup
            const revealObserver = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("services-step-visible");
                            revealObserver.unobserve(entry.target);
                        }
                    });
                },
                { threshold: 0.15 },
            );

            stepEls.forEach((step) => {
                revealObserver.observe(step);
            });

            let ticking = false;

            const updateTimelineProgress = () => {
                const containerRect = stepsContainer.getBoundingClientRect();
                const containerTop = containerRect.top;
                const containerHeight = containerRect.height;

                // Sets progress line to compute trigger around center viewport area
                const triggerPoint = window.innerHeight * 0.45;
                const progress = Math.min(
                    Math.max(
                        (triggerPoint - containerTop) / containerHeight,
                        0,
                    ),
                    1,
                );

                timelineFill.style.transform = `scaleY(${progress})`;

                let dynamicActiveIndex = 0;

                stepEls.forEach((step, i) => {
                    const stepRect = step.getBoundingClientRect();
                    const bubble = bubbles[i] as HTMLElement;
                    if (!bubble) return;

                    // Calculates middle position of current step bubble node container
                    const bubbleCenter = stepRect.top + 18 - containerRect.top;
                    const fillHeight = progress * containerHeight;

                    if (fillHeight >= bubbleCenter) {
                        dynamicActiveIndex = i;
                        if (!bubble.classList.contains("bubble-active")) {
                            bubble.classList.add("bubble-active");
                            step.classList.add("step-active");
                        }
                    } else {
                        if (bubble.classList.contains("bubble-active")) {
                            bubble.classList.remove("bubble-active");
                            step.classList.remove("step-active");
                        }
                    }
                });

                // Dynamically update background giant counter based on scroll focus
                if (timelineCounter) {
                    const nextNum = String(dynamicActiveIndex + 1).padStart(
                        2,
                        "0",
                    );
                    if (timelineCounter.textContent !== nextNum) {
                        timelineCounter.textContent = nextNum;
                    }
                }

                ticking = false;
            };

            const onTimelineScroll = () => {
                if (!ticking) {
                    requestAnimationFrame(updateTimelineProgress);
                    ticking = true;
                }
            };

            window.addEventListener("scroll", onTimelineScroll, {
                passive: true,
            });
            window.addEventListener("resize", onTimelineScroll, {
                passive: true,
            });
            updateTimelineProgress();
        };

        initServicesTimeline();
        document.addEventListener("astro:after-swap", initServicesTimeline);
    </script>

    <style>
        .font-inconsolata {
            font-family: "Inconsolata", "Courier New", monospace;
        }
        .font-oswald {
            font-family: "Oswald", sans-serif;
        }

        /* Initial reveal animation */
        .services-step {
            opacity: 0;
            transform: translateY(20px);
            transition:
                opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .services-step-visible {
            opacity: 1;
            transform: translateY(0);
        }

        .services-step:nth-child(1) {
            transition-delay: 0s;
        }
        .services-step:nth-child(2) {
            transition-delay: 0.1s;
        }
        .services-step:nth-child(3) {
            transition-delay: 0.2s;
        }
        .services-step:nth-child(4) {
            transition-delay: 0.3s;
        }

        /* Step content focusing effects */
        .services-content {
            opacity: 0.35;
            transform: translateX(0);
            transition:
                opacity 0.5s ease,
                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .services-title {
            transition: color 0.4s ease;
        }

        /* Active focus state triggered by scrolling timeline path */
        .step-active .services-content {
            opacity: 1;
            transform: translateX(10px);
        }

        .step-active .services-title {
            color: var(--color-accent, #3b52f6);
        }

        .step-active .services-badge-wrap {
            opacity: 1;
        }

        /* Bubble base structures & micro-pulse rings */
        .services-bubble {
            position: relative;
            transition:
                border-color 0.3s ease-out,
                color 0.3s ease-out,
                background-color 0.3s ease-out,
                box-shadow 0.3s ease-out;
        }

        /* Fills circle backdrop blue, overrides default border and turns inner layout string text white */
        .bubble-active {
            border-color: var(--color-accent, #3b52f6) !important;
            color: #ffffff !important;
            background-color: var(--color-accent, #3b52f6) !important;
            box-shadow: 0 4px 12px rgba(59, 82, 246, 0.25);
        }

        /* Radar ripple effect around active bullet */
        .bubble-active::before {
            content: "";
            position: absolute;
            inset: -1px;
            border: 1px solid var(--color-accent, #3b52f6);
            border-radius: 50%;
            animation: bubble-pulse 2s infinite ease-out;
            pointer-events: none;
        }

        @keyframes bubble-pulse {
            0% {
                transform: scale(1);
                opacity: 0.8;
            }
            100% {
                transform: scale(1.5);
                opacity: 0;
            }
        }
    </style>
</section>
