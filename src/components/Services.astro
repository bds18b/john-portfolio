---
// The approach as a repeating cycle, set like the hero and About collages:
// a ring of four arrows in the accent texture slowly turning on a dot grid,
// the heading inside it, and the four phases as white cards around it. On
// wide screens one card sits in each corner around the ring; on tablets
// they are listed under it in two columns. The cards don't move: only the
// ring does. Phones get a separate list under the ring (.cycle-acc): an
// accordion with the first phase open, one open at a time. Only one of the
// two lists is ever displayed.
import texture from "../assets/accent-texture.png";

const steps = [
    {
        title: "Diagnose",
        description:
            "Dig into business data, customer behavior and lifecycle channels to find the biggest opportunities.",
        // A magnifying glass.
        icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
    },
    {
        title: "Align + Build",
        description:
            "Build the end-to-end retention strategy, prioritized by contribution margin impact.",
        // Stacked layers.
        icon: '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/>',
    },
    {
        title: "Deploy",
        description:
            "Embed with your team and lead execution on the highest-priority initiatives.",
        // A paper plane.
        icon: '<path d="M21 3 10.5 13.5"/><path d="M21 3 14.5 21l-4-7.5L3 9.5 21 3Z"/>',
    },
    {
        title: "Analyze + Scale",
        description:
            "Measure every lever against contribution margin, LTV, time to reorder and MRR.",
        // A rising line.
        icon: '<path d="m3 17 6-6 4 4 8-8"/><path d="M14 7h7v7"/>',
    },
];

const number = (i: number) => String(i + 1).padStart(2, "0");

// The four arrows, drawn in a 400 x 400 space around the centre (200, 200).
// Angles are in degrees clockwise from 12 o'clock. Each arrow is a curved
// band 34 wide, 60 degrees long, then an arrowhead 58 wide and 11 degrees
// long; 19-degree gaps separate them (60 + 11 + 19 = 90).
const C = 200;
const R = 170;
const BAND = 34;
const HEAD = 58;
const BODY_DEG = 60;
const TIP_DEG = 11;
const pt = (r: number, deg: number) => {
    const a = (deg * Math.PI) / 180;
    return `${(C + r * Math.sin(a)).toFixed(2)} ${(C - r * Math.cos(a)).toFixed(2)}`;
};
const outer = R + BAND / 2;
const inner = R - BAND / 2;
const arrows = [0, 1, 2, 3].map((k) => {
    // Centred on 12, 3, 6 and 9 o'clock, so the gaps fall on the diagonals.
    const start = k * 90 - (BODY_DEG + TIP_DEG) / 2;
    const end = start + BODY_DEG;
    return [
        `M${pt(outer, start)}`,
        `A${outer} ${outer} 0 0 1 ${pt(outer, end)}`,
        `L${pt(R + HEAD / 2, end)}`,
        `L${pt(R, end + TIP_DEG)}`,
        `L${pt(R - HEAD / 2, end)}`,
        `L${pt(inner, end)}`,
        `A${inner} ${inner} 0 0 0 ${pt(inner, start)}`,
        "Z",
    ].join(" ");
});
---

<section id="services" class="services">
    <div class="cycle">
        <div class="ring-wrap" data-reveal="pieces">
            <div class="cycle-ring">
                <svg viewBox="0 0 400 400" class="ring-svg" aria-hidden="true">
                    <defs>
                        <!-- The CTA's texture, 102.4 units across: at the ring's
                             widest (500px) that's 128px, the same size as on the
                             buttons, with each of its pixels 2px. -->
                        <pattern id="ring-texture" patternUnits="userSpaceOnUse" width="102.4" height="102.4">
                            <image
                                href={texture.src}
                                width="102.4"
                                height="102.4"
                                preserveAspectRatio="none"
                                image-rendering="optimizeSpeed"
                                style="image-rendering: pixelated"
                            />
                        </pattern>
                    </defs>
                    {arrows.map((d) => <path d={d} />)}
                </svg>
                <div class="cycle-center">
                    <h2 class="cycle-title" data-reveal="lines">
                        The full funnel approach <span class="text-accent cycle-accent keyword accent-texture">to retention</span>
                    </h2>
                    <p class="cycle-intro" data-reveal>
                        I don't chase vanity metrics. I find the levers that move
                        the bottom line.
                    </p>
                </div>
            </div>
        </div>

        <ol class="cycle-steps" role="list">
            {
                steps.map((step, i) => (
                    <li class={`phase phase-${i}`}>
                        <span class="phase-top" aria-hidden="true">
                            <span class="phase-num">{number(i)}</span>
                            <span class="phase-icon">
                                <svg viewBox="0 0 24 24"><Fragment set:html={step.icon} /></svg>
                            </span>
                        </span>
                        <h3 class="phase-title">{step.title}</h3>
                        <p class="phase-text">{step.description}</p>
                    </li>
                ))
            }
        </ol>

        <!-- Phones: the phases as an accordion, the first open. -->
        <ol class="cycle-acc" role="list" data-cycle-acc>
            {
                steps.map((step, i) => (
                    <li class:list={["acc-item", { "is-open": i === 0 }]}>
                        <h3 class="acc-head">
                            <button
                                type="button"
                                class="acc-btn"
                                id={`acc-btn-${i}`}
                                aria-expanded={i === 0 ? "true" : "false"}
                                aria-controls={`acc-panel-${i}`}
                            >
                                <span class="acc-num" aria-hidden="true">
                                    {number(i)}
                                </span>
                                <span class="acc-title">{step.title}</span>
                                <span class="acc-chevron" aria-hidden="true" />
                            </button>
                        </h3>
                        <div
                            class="acc-panel"
                            id={`acc-panel-${i}`}
                            role="region"
                            aria-labelledby={`acc-btn-${i}`}
                            inert={i !== 0}
                        >
                            <div class="acc-panel-inner">
                                <p class="acc-card">{step.description}</p>
                            </div>
                        </div>
                    </li>
                ))
            }
        </ol>
    </div>
</section>

<script>
    // Phones' accordion: tapping a phase opens it and closes the others;
    // tapping the open one closes it. A closed panel is inert, so screen
    // readers and the keyboard skip its hidden text.
    document.querySelectorAll<HTMLElement>("[data-cycle-acc]").forEach((list) => {
        const items = [...list.querySelectorAll<HTMLElement>(".acc-item")];
        const setOpen = (item: HTMLElement, open: boolean) => {
            item.classList.toggle("is-open", open);
            item.querySelector(".acc-btn")?.setAttribute("aria-expanded", String(open));
            item.querySelector(".acc-panel")?.toggleAttribute("inert", !open);
        };
        items.forEach((item) => {
            item.querySelector(".acc-btn")?.addEventListener("click", () => {
                const open = !item.classList.contains("is-open");
                items.forEach((other) => setOpen(other, other === item ? open : false));
            });
        });
    });
</script>

<style>
    /* Clipped at the sides: the ring's dot grid reaches out past it, past
       the screen's edges on a phone. */
    .services {
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        padding: var(--section-space) 20px;
        background: var(--page-bg);
        isolation: isolate;
        overflow-x: clip;
    }
    .cycle {
        --ink: #151515;
        max-width: 560px;
        margin-inline: auto;
    }

    /* ---- The ring --------------------------------------------------------
       On a dot grid like the collages', here a band around the arrows that
       fades out on both sides, so the heading inside stays on plain white.
       (The grid's box is 144% of the ring across; the band runs from just
       inside the arrows, at 50% of the way from the centre to its edge, to
       well outside them.) */
    .ring-wrap {
        position: relative;
        width: min(100%, 340px);
        margin: 0 auto 40px;
    }
    .ring-wrap::before {
        content: "";
        position: absolute;
        inset: -22%;
        z-index: -1;
        pointer-events: none;
        background: radial-gradient(circle, rgb(21 21 21 / 0.2) 1px, transparent 1.5px) 0 0 / 18px 18px;
        -webkit-mask-image: radial-gradient(circle closest-side, transparent 50%, #000 60%, #000 74%, transparent 100%);
        mask-image: radial-gradient(circle closest-side, transparent 50%, #000 60%, #000 74%, transparent 100%);
    }
    /* Its own width is the unit (cqi) for the text inside it, so the
       heading and intro always fit within the circle. Clipped to its own
       box: the spinning SVG is a square, and its corners swing out past the
       box as it turns (enough to make a phone's page scroll sideways). The
       arrows only ever fill the circle inside the box, so nothing visible
       is cut. */
    .cycle-ring {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        container-type: inline-size;
        overflow: clip;
        overflow-clip-margin: 4px;
    }
    .ring-svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
        will-change: transform;
    }
    /* The arrows wear the CTA's texture (the pattern in the markup), with
       the plain accent as the fallback. A thin stroke in the same fill
       softens their corners. */
    .ring-svg path {
        fill: url(#ring-texture) var(--color-accent);
        stroke: url(#ring-texture) var(--color-accent);
        stroke-width: 2;
        stroke-linejoin: round;
    }

    /* Centre content: kept inside the arrows' inner edge (71% of the ring
       across), with room to spare at the corners. */
    .cycle-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3.2cqi;
        text-align: center;
    }
    .cycle-title {
        margin: 0;
        max-width: 56cqi;
        font-family: "Inter Tight", "Inter", sans-serif;
        font-weight: 600;
        font-size: 5.6cqi;
        line-height: 1.08;
        letter-spacing: -0.035em;
        text-wrap: balance;
        color: var(--ink);
    }
    /* "to retention" always on a line of its own, never split (on some
       phones "to" otherwise wrapped up onto the line above). */
    .cycle-accent {
        display: block;
        white-space: nowrap;
    }
    .cycle-intro {
        margin: 0;
        max-width: 48cqi;
        font-family: "Inter", sans-serif;
        font-size: clamp(13px, 3.3cqi, 15.5px);
        line-height: 1.5;
        color: #444;
        text-wrap: balance;
    }

    /* ---- Phase cards (tablets and wide screens) --------------------------
       White cards like the collage pieces: the number on a grey badge and
       the phase's icon on top, then the title and text. */
    .cycle-steps {
        display: none;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .phase {
        padding: 20px 22px 24px;
        border: 1px solid rgb(21 21 21 / 0.08);
        border-radius: 20px;
        background: #fff;
        box-shadow:
            0 1px 2px rgb(21 21 21 / 0.04),
            0 8px 20px -14px rgb(21 21 21 / 0.1);
    }
    .phase-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }
    .phase-num {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: #f3f3f1;
        font-family: "Inter", sans-serif;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--color-accent);
    }
    .phase-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        color: rgb(21 21 21 / 0.4);
    }
    .phase-icon svg {
        width: 22px;
        height: 22px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .phase-title {
        margin: 0 0 8px;
        font-family: "Inter Tight", "Inter", sans-serif;
        font-weight: 600;
        font-size: 1.3rem;
        line-height: 1.15;
        letter-spacing: -0.025em;
        color: var(--ink);
    }
    .phase-text {
        margin: 0;
        font-family: "Inter", sans-serif;
        font-size: 0.9375rem;
        line-height: 1.55;
        color: #444;
    }
    /* ---- Phones: the phases as an accordion ----------------------------
       Every phase is a full-width white card like the cards above: number
       badge, title, chevron. Opening one only grows its card downward to
       show the text (lined up under the title) and fills its badge with the
       accent; nothing else changes shape, so it opens and closes in one
       smooth movement. */
    .cycle-acc {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 10px;
    }
    .acc-item {
        border: 1px solid rgb(21 21 21 / 0.08);
        border-radius: 20px;
        background: #fff;
        box-shadow:
            0 1px 2px rgb(21 21 21 / 0.04),
            0 6px 16px -12px rgb(21 21 21 / 0.1);
    }
    .acc-head {
        margin: 0;
    }
    .acc-btn {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 10px 20px 10px 10px;
        border: 0;
        border-radius: 20px;
        background: transparent;
        color: var(--ink);
        font: inherit;
        text-align: left;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }
    .acc-btn:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
    }
    .acc-num {
        flex: none;
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #f3f3f1;
        font-family: "Inter", sans-serif;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--color-accent);
        transition:
            background-color 0.35s ease,
            color 0.35s ease;
    }
    .acc-title {
        flex: 1;
        font-family: "Inter Tight", "Inter", sans-serif;
        font-weight: 600;
        font-size: 1.2rem;
        line-height: 1.15;
        letter-spacing: -0.025em;
    }
    /* A chevron drawn from two borders: points down when closed, up when
       open. */
    .acc-chevron {
        flex: none;
        width: 9px;
        height: 9px;
        margin-top: -4px;
        border-right: 2px solid rgb(21 21 21 / 0.45);
        border-bottom: 2px solid rgb(21 21 21 / 0.45);
        transform: rotate(45deg);
        transition:
            transform 0.5s var(--ease),
            margin 0.5s var(--ease),
            border-color 0.25s ease;
    }
    @media (hover: hover) {
        .acc-btn:hover .acc-chevron {
            border-color: rgb(21 21 21 / 0.85);
        }
    }
    .acc-item.is-open .acc-num {
        background: var(--accent-fill);
        image-rendering: pixelated;
        color: #fff;
    }
    .acc-item.is-open .acc-chevron {
        margin-top: 4px;
        transform: rotate(-135deg);
    }
    /* The panel opens to its content's height: its one grid row goes from
       0fr to 1fr, and the inner wrapper clips while it does. */
    .acc-panel {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.5s var(--ease);
    }
    .acc-item.is-open .acc-panel {
        grid-template-rows: 1fr;
    }
    .acc-panel-inner {
        min-height: 0;
        overflow: hidden;
    }
    /* The text. The left padding lines it up with the title (row padding
       10 + badge 44 + gap 16); it fades in as the card opens. */
    .acc-card {
        margin: 0;
        padding: 0 22px 22px 70px;
        font-family: "Inter", sans-serif;
        font-size: 0.97rem;
        line-height: 1.6;
        color: rgb(68 68 68 / 0);
        transition: color 0.3s ease;
    }
    .acc-item.is-open .acc-card {
        color: #444;
        transition-delay: 0.1s;
    }
    /* The narrowest phones: full-width text, so the lines aren't cramped. */
    @media (max-width: 359px) {
        .acc-card {
            padding-left: 20px;
        }
    }

    /* ---- Tablets: the cards in two columns under the ring ---------------- */
    @media (min-width: 640px) {
        .cycle {
            max-width: 760px;
        }
        .ring-wrap {
            width: min(100%, 400px);
            margin-bottom: 64px;
        }
        .cycle-acc {
            display: none;
        }
        .cycle-steps {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
    }

    /* ---- Wide screens ----------------------------------------------------
       The full page width, like the hero and the comparison: the ring in the
       middle with one card in each corner, read clockwise from the top left;
       the top two line up with the top of the ring and the bottom two with
       its bottom. */
    @media (min-width: 1024px) {
        .services {
            padding-inline: 48px;
        }
        .cycle {
            --ring: clamp(380px, 34vw, 500px);
            max-width: 1344px;
            display: grid;
            grid-template-columns: 1fr var(--ring) 1fr;
            grid-template-rows: 1fr 1fr;
            grid-template-areas:
                "s0 ring s1"
                "s3 ring s2";
            column-gap: clamp(40px, 5vw, 96px);
            /* On narrower screens the cards are taller than half the ring;
               this keeps the two on each side apart. */
            row-gap: 20px;
        }
        .cycle-steps {
            display: contents;
        }
        .ring-wrap {
            grid-area: ring;
            align-self: center;
            width: 100%;
            margin: 0;
        }
        .phase {
            width: 100%;
            max-width: 340px;
        }
        .phase-0 {
            grid-area: s0;
            justify-self: start;
            align-self: start;
        }
        .phase-1 {
            grid-area: s1;
            justify-self: end;
            align-self: start;
        }
        .phase-2 {
            grid-area: s2;
            justify-self: end;
            align-self: end;
        }
        .phase-3 {
            grid-area: s3;
            justify-self: start;
            align-self: end;
        }
    }

    /* ---- Motion ----------------------------------------------------------
       When the ring scrolls into view it turns and grows into place, then
       keeps turning, once every 48 seconds. Until then it waits at the
       start (paused). */
    .ring-svg {
        animation:
            ring-in 1.4s var(--ease) var(--reveal-delay, 0ms) backwards,
            ring-spin 48s linear infinite;
    }
    @keyframes ring-in {
        from {
            opacity: 0;
            scale: 0.82;
            rotate: -70deg;
        }
    }
    @keyframes ring-spin {
        to {
            transform: rotate(360deg);
        }
    }
    :global(html.reveal-on) .ring-wrap:not(.is-in) .ring-svg {
        animation-play-state: paused;
    }

    @media (prefers-reduced-motion: reduce) {
        .ring-svg {
            animation: none;
        }
        .acc-btn,
        .acc-num,
        .acc-chevron,
        .acc-panel,
        .acc-card {
            transition: none;
        }
    }

    /* ---- Dark ------------------------------------------------------------
       Off-white type, the cards #19191c with no edge and deeper shadows,
       the dot grid in white at low opacity. The ring stays blue. */
    :global(:root[data-site-theme="dark"]) .cycle {
        --ink: #f5f5f2;
    }
    :global(:root[data-site-theme="dark"]) .ring-wrap::before {
        background-image: radial-gradient(circle, rgb(255 255 255 / 0.14) 1px, transparent 1.5px);
    }
    :global(:root[data-site-theme="dark"]) .cycle-intro,
    :global(:root[data-site-theme="dark"]) .phase-text {
        color: rgb(245 245 242 / 0.68);
    }
    :global(:root[data-site-theme="dark"]) .phase,
    :global(:root[data-site-theme="dark"]) .acc-item {
        background: #19191c;
        border-color: transparent;
        box-shadow:
            0 1px 2px rgb(0 0 0 / 0.4),
            0 16px 32px -18px rgb(0 0 0 / 0.6);
    }
    :global(:root[data-site-theme="dark"]) .phase-num,
    :global(:root[data-site-theme="dark"]) .acc-num {
        background: rgb(255 255 255 / 0.06);
    }
    :global(:root[data-site-theme="dark"]) .acc-item.is-open .acc-num {
        background: var(--accent-fill);
    }
    :global(:root[data-site-theme="dark"]) .phase-icon {
        color: rgb(255 255 255 / 0.4);
    }
    :global(:root[data-site-theme="dark"]) .acc-chevron {
        border-color: rgb(255 255 255 / 0.45);
    }
    @media (hover: hover) {
        :global(:root[data-site-theme="dark"]) .acc-btn:hover .acc-chevron {
            border-color: rgb(255 255 255 / 0.85);
        }
    }
    :global(:root[data-site-theme="dark"]) .acc-item.is-open .acc-card {
        color: rgb(245 245 242 / 0.68);
    }
</style>
