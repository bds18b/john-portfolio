---
import "../styles/global.css";

// Only the real domain goes in search results. The preview address
// (retentionfirst.bradenseidl.com) and pages.dev stay out of them.
const LIVE_HOST = "retentionfirst.co";
const isPreview = !Astro.site?.hostname.endsWith(LIVE_HOST);
---

<html lang="en">
	<head>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=Inter+Tight:wght@300..800&family=Unbounded:wght@600..900&display=swap"
			rel="stylesheet"
		/>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- Dark mode, set before the first paint so the page never flashes
		     light. Light unless the visitor picked dark with the nav's button
		     (saved in localStorage as "site-theme"). -->
		<script is:inline>
			try {
				if (localStorage.getItem("site-theme") === "dark") {
					document.documentElement.dataset.siteTheme = "dark";
				}
			} catch {}
		</script>
		<!-- Switches the scroll reveals on (src/scripts/reveal.ts) before
		     anything is drawn, unless reduced motion is set. If the reveal
		     script hasn't started after 4s, everything just shows. -->
		<script is:inline>
			(function () {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				var root = document.documentElement;
				root.classList.add("reveal-on");
				setTimeout(function () {
					if (!window.__revealReady) root.classList.remove("reveal-on");
				}, 4000);
			})();
		</script>
		<!-- Favicon: a white J on the accent blue. The .ico (16/32/48) is for
		     older browsers; the SVG, listed after it, wins everywhere else. -->
		<link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`} sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
		<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`} />
		<meta name="generator" content={Astro.generator} />
		{isPreview && <meta name="robots" content="noindex, nofollow" />}
		<title>John Narducci | Fractional Retention Lead for 8-Figure DTC Brands</title>
		<meta
			name="description"
			content="Fractional retention lead for founders and CEOs of 8-figure DTC CPG brands who want to keep growing without giving up margin."
		/>
	</head>
	<body>
		<slot />

		<script>
			import { initReveal } from "../scripts/reveal";
			initReveal();
		</script>
		<script>
			document.addEventListener("astro:after-swap", () => {
				document.documentElement.style.scrollBehavior = "smooth";
			});
		</script>
	</body>
</html>

<style is:global>
	html {
		background-color: var(--page-bg);
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-behavior: smooth;
	}

	body {
		background-color: var(--page-bg);
		margin: 0;
		width: 100%;
		height: 100%;
	}

	/* Clear of the fixed nav (64px on phones, 80px from 768px), with a
	   little room. */
	[id] {
		scroll-margin-top: 72px;
	}
	@media (min-width: 768px) {
		[id] {
			scroll-margin-top: 88px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto !important;
		}
	}
</style>
