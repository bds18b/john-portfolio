---
import "../styles/global.css";
---

<html lang="en">
	<head>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=Unbounded:wght@600..900&display=swap"
			rel="stylesheet"
		/>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- Favicon: a white J on the accent blue. The .ico (16/32/48) is for
		     older browsers; the SVG, listed after it, wins everywhere else. -->
		<link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`} sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
		<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`} />
		<meta name="generator" content={Astro.generator} />
		<title>John Narducci | Fractional Retention Lead for 8-Figure DTC Brands</title>
		<meta
			name="description"
			content="Fractional retention lead for founders and CEOs of 8-figure DTC CPG brands who want to keep growing without giving up margin."
		/>
	</head>
	<body>
		<slot />

		<script>
			document.addEventListener("astro:after-swap", () => {
				document.documentElement.style.scrollBehavior = "smooth";
			});
		</script>
	</body>
</html>

<style is:global>
	html {
		background-color: #efefed;
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-behavior: smooth;
	}

	body {
		background-color: #efefed;
		margin: 0;
		width: 100%;
		height: 100%;
	}

	[id] {
		scroll-margin-top: 80px;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto !important;
		}
	}
</style>
